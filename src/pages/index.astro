---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getDict } from '../lib/i18n';
import { getCollection } from 'astro:content';

const t = getDict();

const projects = (await getCollection('projects', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => a.data.order - b.data.order);

const blogPosts = (await getCollection('blog', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: p.id.split('/').slice(1).join('/'),
    title: p.data.title,
    date: p.data.date,
    excerpt: p.data.excerpt,
    tags: p.data.tags,
  }));

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/',
  image: 'https://julius-hunold.de/portfolio.jpg',
  email: 'mailto:info@julius-hunold.de',
  jobTitle: 'Softwareentwickler & Prozessautomatisierung',
  worksFor: [
    {
      '@type': 'Organization',
      name: 'sgalinski Internetagentur',
    },
    {
      '@type': 'Organization',
      name: 'MD Telekom',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressRegion: 'Niedersachsen',
    addressCountry: 'DE',
  },
  knowsAbout: [
    'Softwareentwicklung',
    'Prozessautomatisierung',
    'Digitalisierung',
    'PHP',
    'Python',
    'Symfony',
    'Laravel',
    'Flask',
    'FastAPI',
    'TYPO3',
    'Docker',
    'Linux',
    'SQL',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Georg-August-Universität Göttingen',
  },
  sameAs: [
    'https://github.com/dfgsteam',
    'https://www.linkedin.com/in/julius-hunold/',
    'https://www.xing.com/profile/Julius_Hunold',
    'https://www.instagram.com/julius.hunold/',
    'https://hnld.de',
    'https://hunold24.de',
    'https://ennery.de',
  ],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/',
  inLanguage: 'de-DE',
  author: {
    '@type': 'Person',
    name: 'Julius Hunold',
  },
};
---

<Layout t={t} lang="de" jsonLd={[personJsonLd, websiteJsonLd]}>
  <HomePage t={t} lang="de" projects={projects} blogPosts={blogPosts} />
</Layout>
