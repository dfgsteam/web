---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getDict } from '../lib/i18n';
import { getCollection } from 'astro:content';

const t = getDict();

const projects = (await getCollection('projects', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => a.data.order - b.data.order);

const blogPosts = (await getCollection('blog', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: p.id.split('/').slice(1).join('/'),
    title: p.data.title,
    date: p.data.date,
    excerpt: p.data.excerpt,
    tags: p.data.tags,
  }));

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/',
  email: 'mailto:info@julius-hunold.de',
  jobTitle: 'Web Developer & Tech Project Manager',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressCountry: 'DE',
  },
  knowsAbout: ['PHP', 'Python', 'Web Development', 'SQL', 'Linux'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Göttingen',
  },
};
---

<Layout t={t} lang="de" jsonLd={[personJsonLd]}>
  <HomePage t={t} lang="de" projects={projects} blogPosts={blogPosts} />
</Layout>
