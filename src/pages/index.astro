---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import { getDict } from '../lib/i18n';
import { getCollection } from 'astro:content';

const t = getDict();

const projects = (await getCollection('projects', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => a.data.order - b.data.order);

const blogPosts = (await getCollection('blog', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: p.id.split('/').slice(1).join('/'),
    title: p.data.title,
    date: p.data.date,
    excerpt: p.data.excerpt,
    tags: p.data.tags,
  }));

const personData = {
  '@type': 'Person',
  '@id': 'https://julius-hunold.de/#person',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/',
  image: 'https://julius-hunold.de/portfolio.jpg',
  email: 'mailto:info@julius-hunold.de',
  jobTitle: 'Softwareentwickler & Prozessautomatisierung',
  worksFor: [
    {
      '@type': 'Organization',
      name: 'sgalinski Internetagentur',
    },
    {
      '@type': 'Organization',
      name: 'MD Telekom',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressRegion: 'Niedersachsen',
    postalCode: '31157',
    addressCountry: 'DE',
  },
  knowsAbout: [
    'Softwareentwicklung',
    'Prozessautomatisierung',
    'Digitalisierung',
    'PHP',
    'Python',
    'Symfony',
    'Laravel',
    'Flask',
    'FastAPI',
    'TYPO3',
    'Docker',
    'Linux',
    'SQL',
    'Web-Applikationen',
    'E-Commerce',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Georg-August-Universität Göttingen',
  },
  sameAs: [
    'https://github.com/dfgsteam',
    'https://www.linkedin.com/in/julius-hunold/',
    'https://www.xing.com/profile/Julius_Hunold',
    'https://www.instagram.com/julius.hunold/',
    'https://hnld.de',
    'https://hunold24.de',
    'https://ennery.de',
  ],
};

const profilePageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://julius-hunold.de/',
  name: 'Julius Hunold – Softwareentwickler & Prozessautomatisierung',
  description: t.meta.description,
  inLanguage: 'de-DE',
  mainEntity: personData,
};

const professionalServiceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Julius Hunold – Softwareentwicklung & Prozessautomatisierung',
  url: 'https://julius-hunold.de/',
  image: 'https://julius-hunold.de/portfolio.jpg',
  email: 'info@julius-hunold.de',
  telephone: '',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressRegion: 'Niedersachsen',
    postalCode: '31157',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.2389,
    longitude: 9.8553,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Region Hannover' },
    { '@type': 'AdministrativeArea', name: 'Hildesheim' },
    { '@type': 'AdministrativeArea', name: 'Göttingen' },
    { '@type': 'Country', name: 'Deutschland' },
  ],
  serviceType: [
    'Softwareentwicklung',
    'Prozessautomatisierung',
    'Web-App-Entwicklung',
    'Digitalisierung von Geschäftsprozessen',
    'E-Commerce & Shop-Systeme',
    'IT-Infrastruktur & Cloud-Hosting',
  ],
  founder: { '@id': 'https://julius-hunold.de/#person' },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/',
  inLanguage: 'de-DE',
  author: { '@id': 'https://julius-hunold.de/#person' },
};
---

<Layout t={t} lang="de" jsonLd={[profilePageJsonLd, professionalServiceJsonLd, websiteJsonLd]}>
  <HomePage t={t} lang="de" projects={projects} blogPosts={blogPosts} />
</Layout>
