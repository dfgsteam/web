---
import Layout from '../../layouts/Layout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getDict } from '../../lib/i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id }) => id.startsWith('de/'));
  return projects.map((project) => ({
    params: { slug: project.id.split('/').slice(1).join('/') },
    props: { project },
  }));
}

const { project } = Astro.props;
const t = getDict();
const slug = project.id.split('/').slice(1).join('/');

const allProjects = (await getCollection('projects', ({ id }) => id.startsWith('de/')))
  .sort((a, b) => a.data.order - b.data.order);
const related = allProjects.filter((p) => p.id !== project.id).slice(0, 3);

const ogImg = project.data.image ?? `/og/${slug}.jpg`;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  url: `https://julius-hunold.de/projekte/${slug}`,
  image: `https://julius-hunold.de${ogImg}`,
  creator: {
    '@type': 'Person',
    name: 'Julius Hunold',
    url: 'https://julius-hunold.de/',
  },
  datePublished: `${project.data.year}-01-01`,
  keywords: project.data.tech.join(', '),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Startseite',
      item: 'https://julius-hunold.de/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Projekte',
      item: 'https://julius-hunold.de/#projekte',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.data.title,
      item: `https://julius-hunold.de/projekte/${slug}`,
    },
  ],
};
---

<Layout
  t={t}
  lang="de"
  title={`${project.data.title} – ${t.meta.title}`}
  description={project.data.summary}
  path={Astro.url.pathname}
  ogImage={ogImg}
  jsonLd={[softwareJsonLd, breadcrumbJsonLd]}
>
  <ProjectDetail project={project} t={t} lang="de" related={related} />
</Layout>
