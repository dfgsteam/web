---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { getDict } from '../../lib/i18n';
import { getCollection } from 'astro:content';

const t = getDict('en');

const projects = (await getCollection('projects', ({ id }) => id.startsWith('en/')))
  .sort((a, b) => a.data.order - b.data.order);

const blogPosts = (await getCollection('blog', ({ id }) => id.startsWith('en/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((p) => ({
    slug: p.id.split('/').slice(1).join('/'),
    title: p.data.title,
    date: p.data.date,
    excerpt: p.data.excerpt,
    tags: p.data.tags,
  }));

const personData = {
  '@type': 'Person',
  '@id': 'https://julius-hunold.de/en/#person',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/en/',
  image: 'https://julius-hunold.de/portfolio.jpg',
  email: 'mailto:info@julius-hunold.de',
  jobTitle: 'Software Developer & Process Automation',
  worksFor: [
    {
      '@type': 'Organization',
      name: 'sgalinski Internetagentur',
    },
    {
      '@type': 'Organization',
      name: 'MD Telekom',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressRegion: 'Lower Saxony',
    postalCode: '31157',
    addressCountry: 'DE',
  },
  knowsAbout: [
    'Software Development',
    'Process Automation',
    'Digitalization',
    'PHP',
    'Python',
    'Symfony',
    'Laravel',
    'Flask',
    'FastAPI',
    'TYPO3',
    'Docker',
    'Linux',
    'SQL',
    'Web Applications',
    'E-Commerce',
  ],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Göttingen',
  },
  sameAs: [
    'https://github.com/dfgsteam',
    'https://www.linkedin.com/in/julius-hunold/',
    'https://www.xing.com/profile/Julius_Hunold',
    'https://www.instagram.com/julius.hunold/',
    'https://hnld.de',
    'https://hunold24.de',
    'https://ennery.de',
  ],
};

const profilePageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://julius-hunold.de/en/',
  name: 'Julius Hunold – Software Developer & Process Automation',
  description: t.meta.description,
  inLanguage: 'en-GB',
  mainEntity: personData,
};

const professionalServiceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Julius Hunold – Software Development & Process Automation',
  url: 'https://julius-hunold.de/en/',
  image: 'https://julius-hunold.de/portfolio.jpg',
  email: 'info@julius-hunold.de',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressRegion: 'Lower Saxony',
    postalCode: '31157',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.2389,
    longitude: 9.8553,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Hanover Region' },
    { '@type': 'AdministrativeArea', name: 'Hildesheim' },
    { '@type': 'AdministrativeArea', name: 'Göttingen' },
    { '@type': 'Country', name: 'Germany' },
  ],
  serviceType: [
    'Software Development',
    'Process Automation',
    'Custom Web Applications',
    'Digitalization of Business Processes',
    'E-Commerce & Shop Systems',
    'IT Infrastructure & Cloud Hosting',
  ],
  founder: { '@id': 'https://julius-hunold.de/en/#person' },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/en/',
  inLanguage: 'en-GB',
  author: { '@id': 'https://julius-hunold.de/en/#person' },
};
---

<Layout t={t} lang="en" jsonLd={[profilePageJsonLd, professionalServiceJsonLd, websiteJsonLd]}>
  <HomePage t={t} lang="en" projects={projects} blogPosts={blogPosts} />
</Layout>
