---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { getDict } from '../../lib/i18n';
import { getCollection } from 'astro:content';

const t = getDict('en');

const projects = (await getCollection('projects', ({ id }) => id.startsWith('en/')))
  .sort((a, b) => a.data.order - b.data.order);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Julius Hunold',
  url: 'https://julius-hunold.de/en/',
  email: 'mailto:info@julius-hunold.de',
  jobTitle: 'Web Developer & Tech Project Manager',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sarstedt',
    addressCountry: 'DE',
  },
  knowsAbout: ['PHP', 'Python', 'Web Development', 'SQL', 'Linux'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Göttingen',
  },
};
---

<Layout t={t} lang="en" jsonLd={[personJsonLd]}>
  <HomePage t={t} lang="en" projects={projects} />
</Layout>
