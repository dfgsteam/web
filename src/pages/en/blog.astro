---
import Layout from '../../layouts/Layout.astro';
import BlogIndex from '../../components/BlogIndex.astro';
import { getDict } from '../../lib/i18n';
import { getCollection } from 'astro:content';

const t = getDict('en');

const posts = (await getCollection('blog', ({ id }) => id.startsWith('en/')))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((p) => ({
    id: p.id,
    slug: p.id.split('/').slice(1).join('/'),
    title: p.data.title,
    date: p.data.date,
    excerpt: p.data.excerpt,
    tags: p.data.tags,
  }));

const blogIndexJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog – ${t.meta.title}`,
  description: t.blog.subheading,
  url: 'https://julius-hunold.de/en/blog',
  inLanguage: 'en-GB',
  author: {
    '@type': 'Person',
    name: 'Julius Hunold',
    url: 'https://julius-hunold.de/en/',
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.date.toISOString(),
    url: `https://julius-hunold.de/en/blog/${post.slug}`,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://julius-hunold.de/en/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://julius-hunold.de/en/blog',
    },
  ],
};
---

<Layout
  t={t}
  lang="en"
  title={`Blog – ${t.meta.title}`}
  description={t.blog.subheading}
  path={Astro.url.pathname}
  jsonLd={[blogIndexJsonLd, breadcrumbJsonLd]}
>
  <BlogIndex t={t} lang="en" posts={posts} />
</Layout>
