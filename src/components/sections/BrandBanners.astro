---
import { ExternalLink, CheckCircle2 } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;
---

<section id="brands" class="section-spacing relative isolate overflow-hidden border-t border-b border-line bg-base">
  <div class="container-page relative">
    <!-- Header -->
    <div class="mb-14 text-center max-w-3xl mx-auto" data-reveal="up">
      <p class="mb-3 text-xs uppercase tracking-widest text-accent font-mono">
        {t.brands.label}
      </p>
      <h2 class="text-balance text-3xl font-semibold tracking-tight md:text-5xl">
        {t.brands.heading}
      </h2>
    </div>

    <!-- Brand Banners 3-Column Grid -->
    <div class="grid gap-8 lg:grid-cols-3">

      <!-- BRAND 1: HNLD.DE (HIGH-END MODERN DIGITAL AGENCY STUDIO) -->
      <div
        class="group relative overflow-hidden rounded-2xl border border-line bg-surface/90 shadow-2xl transition-all duration-500 hover:-translate-y-1 hover:border-cyan-500/50 hover:shadow-cyan-500/10 flex flex-col justify-between"
        data-reveal="up"
      >
        <!-- Modern Agency Topbar -->
        <div class="flex items-center justify-between border-b border-line bg-base/80 px-4 py-3 backdrop-blur-md">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5">
              <span class="size-2.5 rounded-full bg-red-500/80"></span>
              <span class="size-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="size-2.5 rounded-full bg-green-500/80"></span>
            </div>
            <span class="text-xs font-mono text-dim">hnld.de · Digital Studio</span>
          </div>
          <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-[10px] font-mono text-cyan-400">Webdesign Agency</span>
        </div>

        <!-- Studio Content -->
        <div class="p-6 flex-1 flex flex-col justify-between relative isolate">
          <!-- Background Glow Mesh -->
          <div class="absolute -right-16 -top-16 -z-10 size-64 rounded-full bg-cyan-500/15 blur-3xl group-hover:scale-150 transition-transform duration-700"></div>

          <div>
            <!-- Official Branding Logo -->
            <div class="mb-5 flex items-center gap-3">
              <svg class="h-8 w-auto text-cyan-400" viewBox="0 0 110 32" xmlns="http://www.w3.org/2000/svg">
                <rect x="0" y="4" width="24" height="24" rx="7" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="2"/>
                <text x="6" y="21" font-family="monospace" font-weight="900" font-size="13" fill="currentColor">H</text>
                <text x="32" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="800" font-size="21" letter-spacing="-0.5" fill="currentColor">hnld<tspan font-weight="400" fill-opacity="0.6">.de</tspan></text>
              </svg>
              <div>
                <span class="block text-[11px] font-mono uppercase tracking-widest text-dim">{t.brands.hnld.tag}</span>
              </div>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="text-xl font-bold tracking-tight text-ink group-hover:text-cyan-400 transition-colors">
              {t.brands.hnld.title}
            </h3>
            <p class="mt-3 text-xs leading-relaxed text-mute">
              {t.brands.hnld.subtitle}
            </p>

            <!-- Highlights -->
            <div class="mt-5 space-y-2 rounded-xl border border-line bg-base/50 p-3.5">
              {
                t.brands.hnld.highlights.map((item) => (
                  <div class="flex items-center gap-2 text-xs text-mute font-medium">
                    <CheckCircle2 class="size-3.5 text-cyan-400 shrink-0" stroke-width={2} />
                    <span>{item}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Studio Footer CTA -->
          <div class="mt-6 pt-4 border-t border-line flex items-center justify-between">
            <span class="text-[11px] font-mono text-dim">https://hnld.de</span>
            <a
              href="https://hnld.de"
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="inline-flex items-center gap-1.5 rounded-full bg-cyan-500 px-4 py-2 text-xs font-bold text-black shadow-lg transition-all duration-300 hover:bg-cyan-400 hover:shadow-cyan-500/30 active:scale-95"
            >
              <span>{t.brands.hnld.cta}</span>
              <ExternalLink class="size-3" />
            </a>
          </div>
        </div>
      </div>

      <!-- BRAND 2: HUNOLD24.DE (AUTHENTIC WINDOWS XP LUNA & BLISS THEME) -->
      <div
        class="group relative overflow-hidden rounded-2xl border-2 border-[#0055ea] bg-surface shadow-2xl shadow-[#0055ea]/20 transition-all duration-500 hover:-translate-y-1 hover:shadow-[#0055ea]/30 flex flex-col justify-between"
        data-reveal="up"
        data-reveal-delay="0.08"
      >
        <!-- Windows XP Titlebar -->
        <div class="flex items-center justify-between bg-gradient-to-r from-[#0058e6] via-[#1065f4] to-[#0055ea] px-3.5 py-2 text-white font-sans text-xs font-bold shadow-md select-none border-b border-[#0a48b5]">
          <div class="flex items-center gap-2">
            <!-- Official hunold24 Logo in Titlebar -->
            <img src="/images/logos/hunold24.png" alt="hunold24 logo" class="h-4 w-auto object-contain brightness-200" />
            <span class="tracking-wide text-[11px] drop-shadow-xs truncate">hunold24.exe – Custom Apps</span>
          </div>

          <!-- Windows XP Titlebar Buttons (_, [], X) -->
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" class="flex size-3.5 items-center justify-center rounded-xs bg-[#004fcf] text-[9px] font-bold text-white border border-[#377df4]" aria-label="Minimize">_</button>
            <button type="button" class="flex size-3.5 items-center justify-center rounded-xs bg-[#004fcf] text-[9px] font-bold text-white border border-[#377df4]" aria-label="Maximize">□</button>
            <button type="button" class="flex size-4 items-center justify-center rounded-xs bg-gradient-to-b from-[#e34b35] to-[#b91d09] text-[10px] font-bold text-white border border-[#f57463]" aria-label="Close">✕</button>
          </div>
        </div>

        <!-- Windows XP Bliss Landscape Container -->
        <div class="relative p-6 bg-gradient-to-b from-[#3a9afb] via-[#65befa] via-60% to-[#6fbe47] text-white flex-1 flex flex-col justify-between overflow-hidden">
          <!-- Bliss Soft Clouds Overlay -->
          <div class="absolute top-2 left-6 h-12 w-36 rounded-full bg-white/20 blur-xl pointer-events-none"></div>

          <div class="relative z-10">
            <!-- Official hunold24 Branding Image -->
            <div class="mb-4 flex items-center justify-between">
              <div class="rounded-xl bg-white/10 p-2 backdrop-blur-md border border-white/20 shadow-md">
                <img src="/images/logos/hunold24.png" alt="hunold24" class="h-8 w-auto object-contain brightness-200" />
              </div>
              <div class="inline-flex items-center gap-1.5 rounded-lg bg-black/40 backdrop-blur-md px-2.5 py-1 text-[11px] font-mono text-emerald-300 border border-white/20 shadow-md">
                <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
                {t.brands.hunold24.tag}
              </div>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="text-xl font-extrabold tracking-tight text-white drop-shadow-md">
              {t.brands.hunold24.title}
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-white/95 drop-shadow-xs font-medium">
              {t.brands.hunold24.subtitle}
            </p>

            <!-- Highlights in XP Dialog Box Style -->
            <div class="mt-5 rounded-xl border border-white/30 bg-white/15 p-3.5 backdrop-blur-md shadow-lg space-y-2">
              {
                t.brands.hunold24.highlights.map((item) => (
                  <div class="flex items-center gap-2 text-xs text-white font-medium">
                    <span class="flex size-3.5 items-center justify-center rounded-full bg-[#388d37] text-white text-[9px] font-bold shadow-xs">✓</span>
                    <span class="drop-shadow-xs">{item}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- XP Taskbar Footer with Authentic Start Button & Action -->
          <div class="relative z-10 mt-6 pt-3 border-t border-white/25 flex items-center justify-between gap-2">
            <!-- Authentic Windows XP Start Button -->
            <a
              href="https://hunold24.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-r-xl rounded-l-md bg-gradient-to-b from-[#388d37] via-[#3fa33e] to-[#1e581e] px-3 py-1.5 text-xs font-extrabold text-white shadow-lg border border-[#6fd36d] hover:brightness-110 active:scale-95 transition-all"
            >
              <div class="grid grid-cols-2 gap-0.5 size-3">
                <span class="bg-[#f25022]"></span>
                <span class="bg-[#7fba00]"></span>
                <span class="bg-[#00a4ef]"></span>
                <span class="bg-[#ffb900]"></span>
              </div>
              <span class="italic text-xs font-sans tracking-wide">start</span>
            </a>

            <a
              href="https://hunold24.de"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg bg-white text-[#0055ea] px-3 py-1.5 text-xs font-bold shadow-md hover:bg-slate-100 transition-colors"
            >
              <span>{t.brands.hunold24.cta}</span>
              <ExternalLink class="size-3" />
            </a>
          </div>
        </div>
      </div>

      <!-- BRAND 3: ENNERY (ENERGIEBERATUNGSSOFTWARE & CLEANTECH) -->
      <div
        class="group relative overflow-hidden rounded-2xl border border-emerald-500/30 bg-surface/90 shadow-2xl transition-all duration-500 hover:-translate-y-1 hover:border-emerald-500/60 hover:shadow-emerald-500/15 flex flex-col justify-between"
        data-reveal="up"
        data-reveal-delay="0.16"
      >
        <!-- CleanTech Topbar -->
        <div class="flex items-center justify-between border-b border-emerald-500/20 bg-emerald-950/40 px-4 py-3 backdrop-blur-md">
          <div class="flex items-center gap-2">
            <!-- Official ennery Logo in Topbar -->
            <img src="/images/logos/ennery.png" alt="ennery logo" class="h-4 w-auto object-contain dark:invert" />
            <span class="text-xs font-mono text-emerald-300 font-semibold">ennery · Energy Suite</span>
          </div>
          <span class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-mono text-emerald-400">Energieberatung</span>
        </div>

        <!-- CleanTech Content -->
        <div class="p-6 flex-1 flex flex-col justify-between relative isolate bg-gradient-to-b from-emerald-950/20 via-surface to-surface">
          <!-- Background Glow Mesh -->
          <div class="absolute -right-16 -top-16 -z-10 size-64 rounded-full bg-emerald-500/15 blur-3xl group-hover:scale-150 transition-transform duration-700"></div>

          <div>
            <!-- Official ennery Branding Image -->
            <div class="mb-5 flex items-center justify-between">
              <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3 py-2 shadow-lg backdrop-blur-md">
                <img src="/images/logos/ennery.png" alt="ennery" class="h-8 w-auto object-contain dark:invert" />
              </div>
              <span class="text-[11px] font-mono uppercase tracking-widest text-emerald-400/80">{t.brands.ennery.tag}</span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="text-xl font-bold tracking-tight text-ink group-hover:text-emerald-400 transition-colors">
              {t.brands.ennery.title}
            </h3>
            <p class="mt-3 text-xs leading-relaxed text-mute">
              {t.brands.ennery.subtitle}
            </p>

            <!-- Highlights -->
            <div class="mt-5 space-y-2 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3.5">
              {
                t.brands.ennery.highlights.map((item) => (
                  <div class="flex items-center gap-2 text-xs text-mute font-medium">
                    <CheckCircle2 class="size-3.5 text-emerald-400 shrink-0" stroke-width={2} />
                    <span>{item}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- CleanTech Footer CTA -->
          <div class="mt-6 pt-4 border-t border-line flex items-center justify-between">
            <span class="text-[11px] font-mono text-emerald-400/70">ennery Energie-Software</span>
            <a
              href="#kontakt"
              data-magnetic
              class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500 px-4 py-2 text-xs font-bold text-black shadow-lg transition-all duration-300 hover:bg-emerald-400 hover:shadow-emerald-500/30 active:scale-95"
            >
              <span>{t.brands.ennery.cta}</span>
              <ExternalLink class="size-3" />
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
