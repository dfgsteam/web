---
import type { Dict, Locale } from '../../lib/i18n';
import Button from '../ui/Button.astro';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t, lang } = Astro.props;
---

<section id="cv" class="section-spacing relative isolate overflow-hidden border-t border-line">
  <div class="glow glow--pink glow--float -right-40 top-16 h-[440px] w-[440px]" aria-hidden="true"></div>
  <div class="glow glow--amber glow--float-slow -left-32 bottom-24 h-[360px] w-[360px]" aria-hidden="true"></div>
  <div class="container-page relative">
    <div class="mb-16 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
          {t.cv.label}
        </p>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          {t.cv.heading}
        </h2>
        <p class="mt-5 max-w-xl text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
          {t.cv.subheading}
        </p>
      </div>
      <div data-reveal="up" data-reveal-delay="0.2">
        <Button href="/cv-julius-hunold.pdf" variant="outline" icon="download">
          {t.cv.download}
        </Button>
      </div>
    </div>

    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t.cv.work}
        </h3>
        <ol class="relative space-y-10 border-l border-line pl-8">
          {
            t.cv.workItems.map((entry, i) => (
              <li class="relative" data-reveal="up" data-reveal-delay={i * 0.06}>
                <span class="absolute -left-[37px] top-1 size-3 rounded-full border-2 border-accent bg-base" aria-hidden="true"></span>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h4 class="text-lg font-medium tracking-tight text-ink">{entry.role}</h4>
                  <span class="text-sm text-accent">{entry.company}</span>
                </div>
                <p class="mt-1 text-xs uppercase tracking-wider text-dim">{entry.period}</p>
                <p class="mt-3 text-sm leading-relaxed text-mute">{entry.description}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t.cv.education}
        </h3>
        <ol class="relative space-y-10 border-l border-line pl-8">
          {
            t.cv.educationItems.map((entry, i) => (
              <li class="relative" data-reveal="up" data-reveal-delay={i * 0.06}>
                <span class="absolute -left-[37px] top-1 size-3 rounded-full border-2 border-accent bg-base" aria-hidden="true"></span>
                <h4 class="text-lg font-medium tracking-tight text-ink">{entry.degree}</h4>
                <p class="mt-1 text-sm text-accent">{entry.school}</p>
                <p class="mt-1 text-xs uppercase tracking-wider text-dim">{entry.period}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="mt-20 grid gap-16 lg:grid-cols-2">
      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t.cv.volunteer}
        </h3>
        <ul class="space-y-4">
          {
            t.cv.volunteerItems.map((entry, i) => (
              <li
                class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface px-6 py-5"
                data-reveal="up"
                data-reveal-delay={i * 0.06}
              >
                <div>
                  <h4 class="font-medium tracking-tight text-ink">{entry.role}</h4>
                  <p class="text-sm text-mute">{entry.org}</p>
                </div>
                <span class="shrink-0 text-xs uppercase tracking-wider text-dim">{entry.period}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t.cv.certificates}
        </h3>
        <ul class="space-y-4">
          {
            t.cv.certificateItems.map((entry, i) => (
              <li
                class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface px-6 py-5"
                data-reveal="up"
                data-reveal-delay={i * 0.06}
              >
                <div>
                  <h4 class="font-medium tracking-tight text-ink">{entry.name}</h4>
                  <p class="text-sm text-mute">{entry.issuer}</p>
                </div>
                <span class="shrink-0 text-xs uppercase tracking-wider text-dim">{entry.year}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
