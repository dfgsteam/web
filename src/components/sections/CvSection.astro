---
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t, lang } = Astro.props;
---

<section id="cv" class="section-spacing relative isolate overflow-hidden border-t border-line">
  <!-- Ambient Glow Orbs -->
  <div class="glow glow--pink glow--float -right-40 top-16 h-[440px] w-[440px]" aria-hidden="true"></div>
  <div class="glow glow--amber glow--float-slow -left-32 bottom-24 h-[360px] w-[360px]" aria-hidden="true"></div>

  <div class="container-page relative">
    <!-- Header -->
    <div class="mb-16 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
          {t.cv.label}
        </p>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          {t.cv.heading}
        </h2>
        <p class="mt-5 max-w-xl text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
          {t.cv.subheading}
        </p>
      </div>
      <div data-reveal="up" data-reveal-delay="0.2">
        <button
          type="button"
          onclick="window.print()"
          class="group inline-flex items-center gap-2 rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-semibold text-ink shadow-xs backdrop-blur-md transition-all duration-300 hover:border-accent hover:bg-accent/10 hover:shadow-lg hover:shadow-accent/5 active:scale-95 cursor-pointer"
        >
          <svg class="size-4 text-accent group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 002-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>{t.cv.download}</span>
        </button>
      </div>
    </div>

    <!-- Timeline Grid (Work & Education) -->
    <div class="grid gap-16 lg:grid-cols-2">
      <!-- Berufserfahrung -->
      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink" data-reveal="up">
          <span class="size-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t.cv.work}
        </h3>
        <div class="relative pl-8">
          <!-- Animated Vertical Timeline Axis -->
          <div class="absolute left-0 top-2.5 h-[calc(100%-1rem)] w-px bg-line">
            <div data-cv-timeline class="h-full w-full bg-accent origin-top scale-y-0 shadow-sm shadow-accent/50"></div>
          </div>

          <ol class="space-y-10">
            {
              t.cv.workItems.map((entry, i) => (
                <li class="relative group opacity-35 transition-all duration-500" data-cv-item>
                  <!-- Animated Timeline Node Dot (Inaktiv Grau -> Aktiv Akzent) -->
                  <span
                    data-cv-dot
                    class="absolute -left-[37px] top-1.5 size-3 rounded-full border-2 border-line bg-surface opacity-40 transition-all duration-500 group-hover:scale-125"
                    aria-hidden="true"
                  ></span>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h4 class="text-lg font-medium tracking-tight text-ink group-hover:text-accent transition-colors">{entry.role}</h4>
                    <span class="text-sm font-semibold text-accent">{entry.company}</span>
                  </div>
                  <p class="mt-1 text-xs uppercase tracking-wider text-dim font-mono">{entry.period}</p>
                  <p class="mt-3 text-sm leading-relaxed text-mute">{entry.description}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <!-- Ausbildung -->
      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink" data-reveal="up" data-reveal-delay="0.1">
          <span class="size-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
          {t.cv.education}
        </h3>
        <div class="relative pl-8">
          <!-- Animated Vertical Timeline Axis -->
          <div class="absolute left-0 top-2.5 h-[calc(100%-1rem)] w-px bg-line">
            <div data-cv-timeline class="h-full w-full bg-accent origin-top scale-y-0 shadow-sm shadow-accent/50"></div>
          </div>

          <ol class="space-y-10">
            {
              t.cv.educationItems.map((entry, i) => (
                <li class="relative group opacity-35 transition-all duration-500" data-cv-item>
                  <!-- Animated Timeline Node Dot -->
                  <span
                    data-cv-dot
                    class="absolute -left-[37px] top-1.5 size-3 rounded-full border-2 border-line bg-surface opacity-40 transition-all duration-500 group-hover:scale-125"
                    aria-hidden="true"
                  ></span>
                  <h4 class="text-lg font-medium tracking-tight text-ink group-hover:text-accent transition-colors">{entry.degree}</h4>
                  <p class="mt-1 text-sm font-semibold text-accent">{entry.school}</p>
                  <p class="mt-1 text-xs uppercase tracking-wider text-dim font-mono">{entry.period}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>

    <!-- Cards Grid (Volunteer & Certificates) -->
    <div class="mt-20 grid gap-16 lg:grid-cols-2">
      <!-- Ehrenamt -->
      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink" data-reveal="up">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t.cv.volunteer}
        </h3>
        <ul class="space-y-4">
          {
            t.cv.volunteerItems.map((entry, i) => (
              <li
                class="group flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface p-5 opacity-40 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5"
                data-cv-card
              >
                <div>
                  <h4 class="font-medium tracking-tight text-ink group-hover:text-accent transition-colors">{entry.role}</h4>
                  <p class="text-sm text-mute mt-0.5">{entry.org}</p>
                </div>
                <span class="shrink-0 text-xs font-mono tracking-wider text-dim">{entry.period}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Zertifikate -->
      <div>
        <h3 class="mb-8 flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-ink" data-reveal="up">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          {t.cv.certificates}
        </h3>
        <ul class="space-y-4">
          {
            t.cv.certificateItems.map((entry, i) => (
              <li
                class="group flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface p-5 opacity-40 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5"
                data-cv-card
              >
                <div>
                  <h4 class="font-medium tracking-tight text-ink group-hover:text-accent transition-colors">{entry.name}</h4>
                  <p class="text-sm text-mute mt-0.5">{entry.issuer}</p>
                </div>
                <span class="shrink-0 text-xs font-mono tracking-wider text-dim">{entry.year}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
