---
import { Rocket, Calendar, Layers } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { skills } from '../../data/skills';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

const stats = [
  { value: 20, suffix: '+', label: t.portfolio.kpiProjects, Icon: Rocket },
  { value: 8, suffix: '+', label: t.portfolio.kpiExperience, Icon: Calendar },
  { value: skills.length, suffix: '+', label: t.portfolio.kpiTechnologies, Icon: Layers },
];
---

<section id="portfolio" class="section-spacing relative isolate overflow-hidden">
  <div class="glow glow--amber glow--float -left-24 top-1/4 h-[400px] w-[400px]" aria-hidden="true"></div>
  <div class="glow glow--sky glow--float-slow -right-32 bottom-0 h-[360px] w-[360px]" aria-hidden="true"></div>
  <div class="container-page relative grid gap-16 lg:grid-cols-2 lg:items-center lg:gap-24">
    <div class="relative" data-reveal="up">
      <div
        class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-accent/20 to-accent-2/25 blur-2xl"
        aria-hidden="true"
      ></div>
      <div class="relative overflow-hidden rounded-[2rem] border border-line shadow-2xl shadow-accent/10">
        <img
          src={PORTFOLIO_IMAGE}
          alt={t.portfolio.imageAlt}
          width="800"
          height="1000"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div class="absolute -bottom-5 left-6 rounded-full border border-line bg-surface px-5 py-2 text-sm font-medium text-ink shadow-lg">
        {t.portfolio.imageChip}
      </div>
    </div>

    <div>
      <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
        {t.portfolio.label}
      </p>
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        {t.portfolio.heading}
      </h2>
      <p class="mt-5 max-w-xl text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
        {t.portfolio.subheading}
      </p>

      <dl class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-3">
        {
          stats.map((stat, i) => (
            <div
              class="rounded-2xl border border-line bg-surface p-6 transition-colors duration-300 hover:border-accent/40"
              data-reveal="up"
              data-reveal-delay={0.08 * i}
            >
              <stat.Icon class="size-5 text-accent" stroke-width={1.75} />
              <dd class="mt-3 text-4xl font-semibold tracking-tight text-ink">
                <span data-count data-count-scrub data-count-value={stat.value} data-count-suffix={stat.suffix}>0</span>
              </dd>
              <dt class="mt-2 text-sm leading-snug text-mute">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
