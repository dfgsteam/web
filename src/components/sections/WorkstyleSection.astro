---
import { Brain, Sparkles } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

// List of Strengths & Keywords from AECdisc & Workstyle with weights (weight = font size importance)
const wordsData = [
  { text: 'MOTIVATOR', weight: 75, color: '#ef4444' }, // Red-500
  { text: 'ORGANISATOR', weight: 68, color: '#f59e0b' }, // Amber-500
  { text: 'FÜHRUNGSSTÄRKE', weight: 56, color: '#eab308' }, // Yellow-500
  { text: 'TATKRAFT', weight: 52, color: '#10b981' }, // Emerald-500
  { text: 'Kognitiver Wissensdurst', weight: 38, color: '#a855f7' }, // Purple-500
  { text: 'Entschlussfreude', weight: 36, color: '#f43f5e' }, // Rose-500
  { text: 'Analytische Präzision', weight: 34, color: '#06b6d4' }, // Cyan-500
  { text: 'Ergebnisorientiert', weight: 42, color: '#ef4444' }, // Red-500
  { text: 'Eigeninitiative', weight: 34, color: '#22d3ee' }, // Cyan-400
  { text: 'Innovation', weight: 38, color: '#c084fc' }, // Purple-400
  { text: 'Begeisterungsfähigkeit', weight: 30, color: '#34d399' }, // Emerald-400
  { text: 'Strukturierte Umsetzung', weight: 32, color: '#f87171' }, // Red-400
  { text: 'Verlässlichkeit', weight: 26, color: '#fbbf24' }, // Amber-400
  { text: 'Autodidaktik', weight: 28, color: '#818cf8' }, // Indigo-400
  { text: 'Python & PHP', weight: 24, color: '#34d399' }, // Emerald-400
  { text: 'Aufgabenfokus', weight: 22, color: '#a78bfa' }, // Purple-400
  { text: 'Web-Apps', weight: 26, color: '#38bdf8' }, // Sky-400
  { text: 'Weitblick', weight: 22, color: '#22d3ee' }, // Cyan-400
  { text: 'Flexibilität', weight: 24, color: '#e879f9' }, // Fuchsia-400
  { text: 'Glasfaserausbau', weight: 20, color: '#94a3b8' }, // Slate-400
  { text: 'Prozessoptimierung', weight: 18, color: '#64748b' }, // Slate-500
];
---

<section id="workstyle" class="relative isolate border-t border-line md:min-h-[160vh]">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Central Cloud Glow Orb -->
  <div class="glow glow--violet glow--float left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[550px] w-[550px] opacity-40 pointer-events-none" aria-hidden="true"></div>

  <!-- Sticky Content Wrapper -->
  <div class="container-page relative z-10 section-spacing md:sticky md:top-16 md:py-12">
    <!-- Header -->
    <div class="mb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-mono text-accent mb-3" data-reveal="up">
          <Brain class="size-3.5 text-accent" />
          <span>AECdisc® Algorithmische Stärken-Wolke</span>
        </div>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          Arbeitsweise & Stärkenwolke.
        </h2>
        <p class="mt-2 text-base text-mute leading-relaxed" data-reveal="up" data-reveal-delay="0.1">
          Mathematisch berechnete Wortwolke – schrittweise per Scroll aufbauend.
        </p>
      </div>

      <!-- Live Count Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/90 px-4 py-2 text-xs font-mono text-dim backdrop-blur-md shrink-0 shadow-md" data-reveal="up" data-reveal-delay="0.15">
        <Sparkles class="size-4 text-accent animate-pulse" />
        <span id="cloud-reveal-counter" class="text-ink font-semibold">0 / {wordsData.length} Stärken geladen</span>
      </div>
    </div>

    <!-- D3-CLOUD SVG WORD CLOUD CONTAINER (Clamped & Overflow Hidden) -->
    <div class="relative mx-auto max-w-5xl py-2 select-none text-center flex flex-col items-center justify-center min-h-[420px]" id="d3-cloud-wrapper">
      <svg id="d3-cloud-svg" class="w-full max-w-4xl h-[420px] overflow-hidden pointer-events-auto rounded-2xl"></svg>

      <!-- Bottom Profile Subtitle Tag -->
      <div class="mt-4 flex items-center justify-center gap-4 text-xs font-mono text-dim border-t border-line/40 pt-4 max-w-md mx-auto w-full">
        <span>AECdisc® Potenzialanalyse</span>
        <span>·</span>
        <span class="text-ink font-semibold">Julius Hunold · Motivator & Organisator</span>
      </div>
    </div>
  </div>
</section>

<script>
  import cloud from 'd3-cloud';

  const rawWords = [
    { text: 'MOTIVATOR', weight: 75, color: '#ef4444' },
    { text: 'ORGANISATOR', weight: 68, color: '#f59e0b' },
    { text: 'FÜHRUNGSSTÄRKE', weight: 56, color: '#eab308' },
    { text: 'TATKRAFT', weight: 52, color: '#10b981' },
    { text: 'Kognitiver Wissensdurst', weight: 38, color: '#a855f7' },
    { text: 'Entschlussfreude', weight: 36, color: '#f43f5e' },
    { text: 'Analytische Präzision', weight: 34, color: '#06b6d4' },
    { text: 'Ergebnisorientiert', weight: 42, color: '#ef4444' },
    { text: 'Eigeninitiative', weight: 34, color: '#22d3ee' },
    { text: 'Innovation', weight: 38, color: '#c084fc' },
    { text: 'Begeisterungsfähigkeit', weight: 30, color: '#34d399' },
    { text: 'Strukturierte Umsetzung', weight: 32, color: '#f87171' },
    { text: 'Verlässlichkeit', weight: 26, color: '#fbbf24' },
    { text: 'Autodidaktik', weight: 28, color: '#818cf8' },
    { text: 'Python & PHP', weight: 24, color: '#34d399' },
    { text: 'Aufgabenfokus', weight: 22, color: '#a78bfa' },
    { text: 'Web-Apps', weight: 26, color: '#38bdf8' },
    { text: 'Weitblick', weight: 22, color: '#22d3ee' },
    { text: 'Flexibilität', weight: 24, color: '#e879f9' },
    { text: 'Glasfaserausbau', weight: 20, color: '#94a3b8' },
    { text: 'Prozessoptimierung', weight: 18, color: '#64748b' },
  ];

  function renderD3Cloud() {
    const svgEl = document.querySelector<SVGSVGElement>('#d3-cloud-svg');
    const section = document.querySelector<HTMLElement>('#workstyle');
    const counter = document.querySelector<HTMLElement>('#cloud-reveal-counter');

    if (!svgEl || !section) return;

    // Clear previous SVG contents
    svgEl.innerHTML = '';

    const width = Math.min(850, window.innerWidth - 48);
    const height = 400;

    svgEl.setAttribute('viewBox', `0 0 ${width} ${height}`);

    const wordItems = rawWords.map((d) => ({
      text: d.text,
      size: d.weight,
      color: d.color,
    }));

    // Only rotate short single words like ORGANISATOR or TATKRAFT, NEVER long multi-word phrases like Analytische Präzision!
    const layout = cloud()
      .size([width - 40, height - 40])
      .words(wordItems)
      .padding(10)
      .rotate((d) => (d.text === 'ORGANISATOR' || d.text === 'TATKRAFT' ? -90 : 0))
      .font('Inter, sans-serif')
      .fontSize((d) => (d as any).size)
      .on('end', draw);

    layout.start();

    function draw(words: any[]) {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('transform', `translate(${width / 2},${height / 2})`);
      if (svgEl) svgEl.appendChild(g);

      const textElements: SVGTextElement[] = [];

      words.forEach((item) => {
        const textNode = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        textNode.setAttribute('text-anchor', 'middle');
        textNode.setAttribute('transform', `translate(${item.x},${item.y}) rotate(${item.rotate})`);
        textNode.style.fontSize = `${item.size}px`;
        textNode.style.fontFamily = 'Inter, sans-serif';
        textNode.style.fontWeight = item.size > 40 ? '900' : item.size > 28 ? '700' : '600';
        textNode.style.fill = item.color;
        textNode.style.transition = 'all 0.6s ease-out';
        textNode.style.opacity = '0';
        textNode.style.transformOrigin = 'center';
        textNode.classList.add('d3-cloud-word');
        textNode.textContent = item.text;

        g.appendChild(textNode);
        textElements.push(textNode);
      });

      // Scroll Reveal Logic
      function updateWordCloudProgress() {
        if (!section) return;

        const rect = section.getBoundingClientRect();
        const totalScrollableHeight = rect.height - window.innerHeight;

        // Mobile fallback: reveal all words immediately
        if (window.innerWidth < 768 || totalScrollableHeight <= 0) {
          textElements.forEach((w) => {
            w.style.opacity = '1';
            w.style.filter = 'none';
          });
          if (counter) counter.textContent = `${textElements.length} / ${textElements.length} Stärken geladen`;
          return;
        }

        const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));
        const activeCount = Math.floor(progress * (textElements.length + 1));

        textElements.forEach((word, idx) => {
          if (idx < activeCount) {
            word.style.opacity = '1';
            word.style.filter = 'none';
          } else {
            word.style.opacity = '0';
            word.style.filter = 'blur(4px)';
          }
        });

        if (counter) {
          const currentRevealed = Math.min(textElements.length, activeCount);
          counter.textContent = `${currentRevealed} / ${textElements.length} Stärken geladen`;
        }
      }

      window.addEventListener('scroll', updateWordCloudProgress, { passive: true });
      updateWordCloudProgress();
    }
  }

  renderD3Cloud();
  document.addEventListener('astro:page-load', renderD3Cloud);
</script>
