---
import { Brain, Sparkles } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

// Authentic Chaotic Wordle Layout Parameters (Horizontal & Vertical mix, bold colors, tight packing)
const cloudWords = [
  { text: 'MOTIVATOR', size: 'text-4xl sm:text-6xl font-black', color: 'text-red-500', orient: 'rotate-0' },
  { text: 'ORGANISATOR', size: 'text-3xl sm:text-5xl font-black', color: 'text-amber-400', orient: 'md:-rotate-90' },
  { text: 'Tatkraft', size: 'text-2xl sm:text-4xl font-extrabold', color: 'text-emerald-400', orient: 'rotate-0' },
  { text: 'Analytische Präzision', size: 'text-lg sm:text-2xl font-bold', color: 'text-cyan-400', orient: 'md:rotate-90' },
  { text: 'Kognitiver Wissensdurst', size: 'text-xl sm:text-3xl font-black', color: 'text-purple-400', orient: 'rotate-0' },
  { text: 'Entschlussfreude', size: 'text-2xl sm:text-4xl font-extrabold', color: 'text-red-400', orient: 'md:-rotate-6' },
  { text: 'Autodidakt', size: 'text-xl sm:text-3xl font-black', color: 'text-indigo-400', orient: 'rotate-0' },
  { text: 'Führungsstärke', size: 'text-3xl sm:text-5xl font-black', color: 'text-amber-500', orient: 'md:rotate-180 md:[writing-mode:vertical-lr]' },
  { text: 'Begeisterung', size: 'text-lg sm:text-2xl font-bold', color: 'text-emerald-300', orient: 'rotate-0' },
  { text: 'Eigeninitiative', size: 'text-2xl sm:text-4xl font-extrabold', color: 'text-cyan-300', orient: 'md:-rotate-90' },
  { text: 'Ergebnisorientiert', size: 'text-3xl sm:text-5xl font-black', color: 'text-red-500', orient: 'rotate-0' },
  { text: 'Prozessoptimierung', size: 'text-xs sm:text-sm font-mono', color: 'text-dim', orient: 'rotate-0' },
  { text: 'Verlässlichkeit', size: 'text-xl sm:text-3xl font-extrabold', color: 'text-amber-300', orient: 'md:rotate-6' },
  { text: 'Innovation', size: 'text-3xl sm:text-5xl font-black', color: 'text-purple-400', orient: 'rotate-0' },
  { text: 'Aufgabenfokus', size: 'text-lg sm:text-2xl font-bold', color: 'text-emerald-400', orient: 'md:rotate-90' },
  { text: 'Flexibilität', size: 'text-xl sm:text-3xl font-bold', color: 'text-cyan-400', orient: 'rotate-0' },
  { text: 'Strukturierte Umsetzung', size: 'text-2xl sm:text-4xl font-black', color: 'text-red-400', orient: 'rotate-0' },
  { text: 'Glasfaserausbau', size: 'text-sm sm:text-lg font-mono', color: 'text-dim', orient: 'md:-rotate-90' },
  { text: 'Web-Apps', size: 'text-2xl sm:text-4xl font-black', color: 'text-amber-400', orient: 'rotate-0' },
  { text: 'Python & PHP', size: 'text-xl sm:text-3xl font-extrabold', color: 'text-emerald-400', orient: 'md:rotate-6' },
  { text: 'Weitblick', size: 'text-lg sm:text-2xl font-bold', color: 'text-indigo-400', orient: 'rotate-0' },
  { text: 'Teamkoordination', size: 'text-xl sm:text-3xl font-black', color: 'text-purple-300', orient: 'rotate-0' },
];
---

<section id="workstyle" class="relative isolate border-t border-line md:min-h-[170vh]">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Glow Orbs -->
  <div class="glow glow--violet glow--float -right-32 top-10 h-[450px] w-[450px]" aria-hidden="true"></div>
  <div class="glow glow--sky glow--float-slow -left-32 bottom-0 h-[400px] w-[400px]" aria-hidden="true"></div>

  <!-- Sticky Content Wrapper -->
  <div class="container-page relative z-10 section-spacing md:sticky md:top-16 md:py-16">
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-mono text-accent mb-3" data-reveal="up">
          <Brain class="size-3.5 text-accent" />
          <span>AECdisc® Stärken- & Potenzial-Collage</span>
        </div>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          Arbeitsweise & Wortwolke.
        </h2>
        <p class="mt-3 text-base text-mute leading-relaxed" data-reveal="up" data-reveal-delay="0.1">
          Scrolle nach unten, um die Stärken- & Potenzial-Collage Wort für Wort aufzubauen.
        </p>
      </div>

      <!-- Live Count Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/90 px-4 py-2 text-xs font-mono text-dim backdrop-blur-md shrink-0 shadow-md" data-reveal="up" data-reveal-delay="0.15">
        <Sparkles class="size-4 text-accent animate-pulse" />
        <span id="cloud-reveal-counter" class="text-ink font-semibold">0 / {cloudWords.length} Stärken geladen</span>
      </div>
    </div>

    <!-- Authentic Chaotic Wordle Collage Container -->
    <div class="relative overflow-hidden rounded-3xl border border-accent/40 bg-gradient-to-br from-surface/95 via-surface/85 to-accent/10 p-6 md:p-12 shadow-2xl backdrop-blur-xl">
      <!-- Background Glow -->
      <div class="absolute -right-20 -bottom-20 size-80 rounded-full bg-accent/15 blur-3xl pointer-events-none"></div>

      <!-- Chaotic Word Cloud Flex Layout -->
      <div class="relative z-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-3 md:gap-x-6 md:gap-y-4 py-8 select-none text-center leading-none" id="workstyle-word-cloud">
        {
          cloudWords.map((word, i) => (
            <span
              data-cloud-index={i}
              class={`cloud-word inline-block ${word.size} ${word.color} ${word.orient} tracking-tight leading-none transition-all duration-700 ease-out cursor-default opacity-0 scale-75 translate-y-4 hover:scale-110 hover:z-30 hover:brightness-125`}
            >
              {word.text}
            </span>
          ))
        }
      </div>

      <!-- Bottom Profile Footer Tag -->
      <div class="relative z-10 mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-xs font-mono text-dim">
        <span>Geprüftes Potenzialprofil</span>
        <span class="text-ink">Julius Hunold · Motivator & Organisator</span>
      </div>
    </div>
  </div>
</section>

<script>
  function initWordCloudScroll() {
    const section = document.querySelector<HTMLElement>('#workstyle');
    const words = document.querySelectorAll<HTMLElement>('.cloud-word');
    const counter = document.querySelector<HTMLElement>('#cloud-reveal-counter');

    if (!section || !words.length) return;

    function updateWordCloudProgress() {
      if (!section) return;

      const rect = section.getBoundingClientRect();
      const totalScrollableHeight = rect.height - window.innerHeight;

      // Mobile fallback: reveal all words immediately for seamless mobile experience
      if (window.innerWidth < 768 || totalScrollableHeight <= 0) {
        words.forEach((w) => {
          w.style.opacity = '1';
          w.style.transform = 'scale(1) translateY(0)';
          w.style.filter = 'none';
        });
        if (counter) counter.textContent = `${words.length} / ${words.length} Stärken geladen`;
        return;
      }

      // Progress from 0 to 1 as user scrolls through section height
      const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));
      const activeCount = Math.floor(progress * (words.length + 1));

      words.forEach((word, idx) => {
        if (idx < activeCount) {
          word.style.opacity = '1';
          word.style.transform = 'scale(1) translateY(0)';
          word.style.filter = 'none';
        } else {
          word.style.opacity = '0';
          word.style.transform = 'scale(0.6) translateY(16px)';
          word.style.filter = 'blur(3px)';
        }
      });

      if (counter) {
        const currentRevealed = Math.min(words.length, activeCount);
        counter.textContent = `${currentRevealed} / ${words.length} Stärken geladen`;
      }
    }

    window.addEventListener('scroll', updateWordCloudProgress, { passive: true });
    updateWordCloudProgress();
  }

  initWordCloudScroll();
  document.addEventListener('astro:page-load', initWordCloudScroll);
</script>
