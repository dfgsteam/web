---
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

---

<section id="workstyle" class="relative isolate border-t border-line md:min-h-[160vh]">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Central Cloud Glow Orb -->
  <div class="glow glow--violet glow--float left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[550px] w-[550px] opacity-40 pointer-events-none" aria-hidden="true"></div>

  <!-- Sticky Content Wrapper -->
  <div class="container-page relative z-10 section-spacing md:sticky md:top-16 md:py-12">
    <!-- Header -->
    <div class="mb-6 max-w-3xl">
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        Arbeitsweise & Fokus.
      </h2>
      <p class="mt-3 text-base text-mute leading-relaxed md:text-lg" data-reveal="up" data-reveal-delay="0.1">
        Pragmatische Umsetzung, analytische Präzision und Führungsstärke auf den Punkt gebracht.
      </p>
    </div>

    <!-- D3-CLOUD SVG WORD CLOUD CONTAINER -->
    <div class="relative mx-auto max-w-5xl py-2 select-none text-center flex flex-col items-center justify-center min-h-[420px]" id="d3-cloud-wrapper">
      <svg id="d3-cloud-svg" class="w-full max-w-4xl h-[420px] overflow-hidden pointer-events-auto rounded-2xl"></svg>

      <!-- Bottom Profile Tag -->
      <div class="mt-4 flex items-center justify-center text-xs font-mono text-dim border-t border-line/40 pt-4 max-w-md mx-auto w-full">
        <span class="text-ink font-semibold">Julius Hunold · Motivator & Organisator</span>
      </div>
    </div>
  </div>
</section>

<script>
  import cloud from 'd3-cloud';

  const rawWords = [
    { text: 'MOTIVATOR', weight: 78, color: '#ef4444' },
    { text: 'ORGANISATOR', weight: 70, color: '#f59e0b' },
    { text: 'FÜHRUNGSSTÄRKE', weight: 60, color: '#eab308' },
    { text: 'Autodidaktik', weight: 46, color: '#818cf8' },
    { text: 'Pragmatische Lösungen', weight: 44, color: '#10b981' },
    { text: 'Eigeninitiative', weight: 42, color: '#06b6d4' },
    { text: 'Kreative Originalität', weight: 40, color: '#c084fc' },
    { text: 'Kognitiver Wissensdurst', weight: 38, color: '#a855f7' },
    { text: 'Ergebnisorientiert', weight: 45, color: '#ef4444' },
    { text: 'Intuitive Herangehensweise', weight: 36, color: '#38bdf8' },
    { text: 'Hohe Zielsetzungen', weight: 36, color: '#f43f5e' },
    { text: 'Gespür für Dringlichkeiten', weight: 34, color: '#f59e0b' },
    { text: 'Enthusiasmus & Dynamik', weight: 34, color: '#22d3ee' },
    { text: 'Autonomie & Unabhängigkeit', weight: 32, color: '#818cf8' },
    { text: 'Daten & Fakten', weight: 32, color: '#06b6d4' },
    { text: 'Innovationsdrang', weight: 38, color: '#c084fc' },
    { text: 'Abwechslung', weight: 30, color: '#34d399' },
    { text: 'Verlässlichkeit', weight: 26, color: '#fbbf24' },
    { text: 'Projektkoordination', weight: 28, color: '#38bdf8' },
    { text: 'Objektive Wahrheit', weight: 24, color: '#94a3b8' },
    { text: 'Entschlussfreude', weight: 30, color: '#f43f5e' },
    { text: 'Flexibilität', weight: 26, color: '#e879f9' },
  ];

  function renderD3Cloud() {
    const svgEl = document.querySelector<SVGSVGElement>('#d3-cloud-svg');
    const section = document.querySelector<HTMLElement>('#workstyle');

    if (!svgEl || !section) return;

    // Clear previous SVG contents
    svgEl.innerHTML = '';

    const width = Math.min(850, window.innerWidth - 48);
    const height = 400;

    svgEl.setAttribute('viewBox', `0 0 ${width} ${height}`);

    const wordItems = rawWords.map((d) => ({
      text: d.text,
      size: d.weight,
      color: d.color,
    }));

    // Clean horizontal & vertical orientation mix (0deg and -90deg / 90deg for single terms)
    const layout = cloud()
      .size([width - 40, height - 40])
      .words(wordItems)
      .padding(10)
      .rotate((d) => (d.text === 'ORGANISATOR' || d.text === 'Eigeninitiative' || d.text === 'FÜHRUNGSSTÄRKE' || d.text === 'Autodidaktik' ? -90 : 0))
      .font('Inter, sans-serif')
      .fontSize((d) => (d as any).size)
      .on('end', draw);

    layout.start();

    function draw(words: any[]) {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('transform', `translate(${width / 2},${height / 2})`);
      if (svgEl) svgEl.appendChild(g);

      const textElements: SVGTextElement[] = [];

      words.forEach((item) => {
        const textNode = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        textNode.setAttribute('text-anchor', 'middle');
        textNode.setAttribute('transform', `translate(${item.x},${item.y}) rotate(${item.rotate})`);
        textNode.style.fontSize = `${item.size}px`;
        textNode.style.fontFamily = 'Inter, sans-serif';
        textNode.style.fontWeight = item.size > 40 ? '900' : item.size > 28 ? '700' : '600';
        textNode.style.fill = item.color;
        textNode.style.transition = 'all 0.6s ease-out';
        textNode.style.opacity = '0';
        textNode.style.transformOrigin = 'center';
        textNode.classList.add('d3-cloud-word');
        textNode.textContent = item.text;

        g.appendChild(textNode);
        textElements.push(textNode);
      });

      // Scroll Reveal Logic
      function updateWordCloudProgress() {
        if (!section) return;

        const rect = section.getBoundingClientRect();
        const totalScrollableHeight = rect.height - window.innerHeight;

        // Mobile fallback: reveal all words immediately
        if (window.innerWidth < 768 || totalScrollableHeight <= 0) {
          textElements.forEach((w) => {
            w.style.opacity = '1';
            w.style.filter = 'none';
          });
          return;
        }

        const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));
        const activeCount = Math.floor(progress * (textElements.length + 1));

        textElements.forEach((word, idx) => {
          if (idx < activeCount) {
            word.style.opacity = '1';
            word.style.filter = 'none';
          } else {
            word.style.opacity = '0';
            word.style.filter = 'blur(4px)';
          }
        });
      }

      window.addEventListener('scroll', updateWordCloudProgress, { passive: true });
      updateWordCloudProgress();
    }
  }

  renderD3Cloud();
  document.addEventListener('astro:page-load', renderD3Cloud);
</script>
