---

<section id="workstyle" class="relative isolate border-t border-line md:min-h-[150vh]">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Central Glow Orbs -->
  <div class="glow glow--violet glow--float -left-20 top-1/3 h-[600px] w-[600px] opacity-35 pointer-events-none" aria-hidden="true"></div>
  <div class="glow glow--sky glow--float-slow -right-20 bottom-1/4 h-[550px] w-[550px] opacity-35 pointer-events-none" aria-hidden="true"></div>

  <!-- ULTRA-WIDE FULL-WIDTH STICKY CONTAINER (1400px width) -->
  <div class="w-full max-w-[1400px] mx-auto px-4 md:px-8 relative z-10 section-spacing md:sticky md:top-16 md:py-10">
    <!-- Header -->
    <div class="mb-8 flex flex-col md:flex-row md:items-end md:justify-between gap-4 border-b border-line/40 pb-6">
      <div class="max-w-3xl">
        <span class="block text-xs uppercase tracking-widest text-accent font-mono mb-2">Persönlichkeit & Profiling</span>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          Arbeitsweise & Fokus.
        </h2>
        <p class="mt-2 text-base text-mute leading-relaxed md:text-lg" data-reveal="up" data-reveal-delay="0.1">
          Pragmatische Umsetzung, analytische Präzision und Führungsstärke auf den Punkt gebracht.
        </p>
      </div>

      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/90 px-4 py-2 text-xs font-mono text-dim backdrop-blur-md shrink-0 shadow-md">
        <Sparkles class="size-4 text-accent" />
        <span class="text-ink font-semibold">Julius Hunold · Motivator & Organisator</span>
      </div>
    </div>

    <!-- TOP 2 HERO PROFILE CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
      <!-- Motivator Card -->
      <div class="rounded-3xl border border-red-500/30 bg-gradient-to-br from-surface/95 via-surface/90 to-red-500/10 p-7 md:p-8 shadow-xl backdrop-blur-md">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <Zap class="size-6 text-red-400" />
            <span class="text-xs font-mono tracking-wider text-red-400 uppercase font-bold">Haupttyp</span>
          </div>
          <span class="text-xs font-mono text-dim border border-red-500/30 px-3 py-1 rounded-full">Tatkraft 76% · Einfluss 73%</span>
        </div>
        <h3 class="text-2xl md:text-3xl font-black text-ink mb-2">MOTIVATOR</h3>
        <p class="text-sm text-mute leading-relaxed">
          Starker Entschluss- und Taten-Drive. Begeistert Teams für innovative Projekte, übernimmt Verantwortung und treibt Veränderung ohne Leerlauf voran.
        </p>
      </div>

      <!-- Organisator Card -->
      <div class="rounded-3xl border border-amber-500/30 bg-gradient-to-br from-surface/95 via-surface/90 to-amber-500/10 p-7 md:p-8 shadow-xl backdrop-blur-md">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <Brain class="size-6 text-amber-400" />
            <span class="text-xs font-mono tracking-wider text-amber-400 uppercase font-bold">Angepasster Typ</span>
          </div>
          <span class="text-xs font-mono text-dim border border-amber-500/30 px-3 py-1 rounded-full">Kognitiv 71/100 · Führung 77%</span>
        </div>
        <h3 class="text-2xl md:text-3xl font-black text-ink mb-2">ORGANISATOR</h3>
        <p class="text-sm text-mute leading-relaxed">
          Kombiniert den Motivator-Drive mit strukturierter Präzision. Stützt sich auf Daten, Fakten & logische Systemarchitekturen für verlässliche Ergebnisse.
        </p>
      </div>
    </div>

    <!-- ULTRA-WIDE STRENGTHS WALL GRID (Spans 1400px width) -->
    <div class="w-full relative select-none">
      <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4 py-4" id="strengths-wall">
        {
          strengthsList.map((item, idx) => (
            <div
              data-strength-index={idx}
              class={`strength-pill cursor-default rounded-2xl border px-4 py-2.5 md:px-5 md:py-3 shadow-lg backdrop-blur-md transition-all duration-700 ease-out hover:scale-105 hover:z-20 ${item.color}`}
            >
              <span>{item.text}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  function initStrengthsWallScroll() {
    const section = document.querySelector<HTMLElement>('#workstyle');
    const pills = document.querySelectorAll<HTMLElement>('.strength-pill');

    if (!section || !pills.length) return;

    function updateStrengthsWallProgress() {
      if (!section) return;

      const rect = section.getBoundingClientRect();
      const totalScrollableHeight = rect.height - window.innerHeight;

      // Mobile fallback: reveal all immediately
      if (window.innerWidth < 768 || totalScrollableHeight <= 0) {
        pills.forEach((p) => {
          p.style.opacity = '1';
          p.style.transform = 'scale(1) translateY(0)';
          p.style.filter = 'none';
        });
        return;
      }

      const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));
      const activeCount = Math.floor(progress * (pills.length + 1));

      pills.forEach((pill, idx) => {
        if (idx < activeCount) {
          pill.style.opacity = '1';
          pill.style.transform = 'scale(1) translateY(0)';
          pill.style.filter = 'none';
        } else {
          pill.style.opacity = '0';
          pill.style.transform = 'scale(0.85) translateY(16px)';
          pill.style.filter = 'blur(4px)';
        }
      });
    }

    window.addEventListener('scroll', updateStrengthsWallProgress, { passive: true });
    updateStrengthsWallProgress();
  }

  initStrengthsWallScroll();
  document.addEventListener('astro:page-load', initStrengthsWallScroll);
</script>
