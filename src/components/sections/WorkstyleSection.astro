---
import {
  Zap,
  LayoutList,
  Users,
  Target,
  Rocket,
  Lightbulb,
  BookOpen,
  Kanban,
  CheckCircle,
  Sparkles,
} from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

const iconMap: Record<string, any> = {
  zap: Zap,
  'layout-list': LayoutList,
  users: Users,
  target: Target,
  rocket: Rocket,
  lightbulb: Lightbulb,
  'book-open': BookOpen,
  kanban: Kanban,
  'check-circle': CheckCircle,
  sparkles: Sparkles,
};
---

<section id="workstyle" class="relative isolate border-t border-line">
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <div class="glow glow--violet glow--float left-1/2 top-1/3 -translate-x-1/2 h-[500px] w-[500px] opacity-40 pointer-events-none" aria-hidden="true"></div>

  <div class="container-page max-w-7xl relative z-10 section-spacing">
    <div class="mb-12 max-w-3xl">
      <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
        {t.workstyle.label}
      </p>
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        {t.workstyle.heading}
      </h2>
      <p class="mt-5 text-base leading-relaxed text-mute md:text-lg" data-reveal="up" data-reveal-delay="0.1">
        {t.workstyle.subheading}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        t.workstyle.strengths.map((strength, i) => {
          const Icon = iconMap[strength.icon] ?? Sparkles;
          return (
            <div
              class="group rounded-2xl border border-line bg-surface p-5 transition-colors duration-300 hover:border-accent/50 hover:bg-accent/5"
              data-reveal="up"
              data-reveal-delay={(i % 5) * 0.06 + Math.floor(i / 5) * 0.06}
            >
              <Icon class="size-6 text-accent" stroke-width={1.75} />
              <h3 class="mt-4 font-medium tracking-tight text-ink">{strength.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-mute">{strength.text}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
