---
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;
---

<section id="workstyle" class="relative isolate border-t border-line md:min-h-[160vh]">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Central Cloud Glow Orb -->
  <div class="glow glow--violet glow--float left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[650px] w-[650px] opacity-40 pointer-events-none" aria-hidden="true"></div>

  <!-- Sticky Content Wrapper (Expansive max-w-7xl layout for wide screens) -->
  <div class="container-page max-w-7xl relative z-10 section-spacing md:sticky md:top-16 md:py-10">
    <!-- Header -->
    <div class="mb-4 max-w-3xl">
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        Arbeitsweise & Fokus.
      </h2>
      <p class="mt-2 text-base text-mute leading-relaxed md:text-lg" data-reveal="up" data-reveal-delay="0.1">
        Pragmatische Umsetzung, analytische Präzision und Führungsstärke auf den Punkt gebracht.
      </p>
    </div>

    <!-- HIGH-DENSITY WORDCLOUD2 DOM CONTAINER (Inside-out scroll reveal) -->
    <div class="relative mx-auto w-full py-2 select-none text-center flex flex-col items-center justify-center min-h-[540px]" id="wordcloud-wrapper">
      <div id="wordcloud-container" class="relative w-full max-w-7xl h-[540px] rounded-2xl pointer-events-auto overflow-hidden"></div>

      <!-- Bottom Profile Tag -->
      <div class="mt-4 flex items-center justify-center text-xs font-mono text-dim border-t border-line/40 pt-3 max-w-md mx-auto w-full">
        <span class="text-ink font-semibold">Julius Hunold · Motivator & Organisator</span>
      </div>
    </div>
  </div>
</section>

<script>
  import WordCloud from 'wordcloud';

  // 120+ Curated Strengths, Traits & Technology Terms for WordCloud2
  const fullWordList: [string, number][] = [
    // Core Hero Terms
    ['MOTIVATOR', 95],
    ['ORGANISATOR', 88],
    ['FÜHRUNGSSTÄRKE', 78],
    ['TATKRAFT', 75],
    ['EIGENINITIATIVE', 70],
    ['ENTSCHLUSSFREUDE', 68],
    ['Autodidaktik', 62],
    ['Pragmatische Lösungen', 58],
    ['Kreative Originalität', 55],
    ['Kognitiver Wissensdurst', 56],
    ['Ergebnisorientiert', 64],
    ['Intuitive Herangehensweise', 52],
    ['Hohe Zielsetzungen', 52],
    ['Gespür für Dringlichkeiten', 48],
    ['Enthusiasmus & Dynamik', 48],
    ['Autonomie & Unabhängigkeit', 45],
    ['Daten & Fakten', 45],
    ['Innovationsdrang', 52],
    ['Analytische Präzision', 48],

    // Medium Attributes & Workstyle Principles
    ['Projektkoordination', 40],
    ['Abwechslungsreiche Aufgaben', 38],
    ['Verlässlichkeit', 35],
    ['Objektive Wahrheit', 32],
    ['Prozessoptimierung', 35],
    ['Web-Engineering', 38],
    ['Systemarchitektur', 35],
    ['Lösungsorientierung', 40],
    ['Veränderungsbereitschaft', 32],
    ['Extrovertierter Drive', 35],
    ['Optimismus & Charisma', 38],
    ['Fachwissen aufbauen', 32],
    ['Flexibilität', 35],
    ['Unabhängiges Arbeiten', 32],
    ['Systematisches Denken', 32],
    ['Zielstrebigkeit', 38],
    ['Handlungsstärke', 35],
    ['Strategischer Weitblick', 35],
    ['Ressourceneffizienz', 30],
    ['Schnelle Auffassungsgabe', 35],
    ['Durchsetzungsvermögen', 32],
    ['Strukturierte Abläufe', 32],
    ['Entschlusskraft', 35],
    ['Anpassungsfähigkeit', 30],

    // Technical & Domain Terms
    ['Python', 36],
    ['TypeScript', 36],
    ['Astro.js', 34],
    ['Docker', 34],
    ['Linux', 30],
    ['Hetzner Servers', 30],
    ['PostgreSQL', 30],
    ['TailwindCSS', 30],
    ['REST APIs', 30],
    ['OpenAI API', 34],
    ['Ollama', 30],
    ['DevOps', 30],
    ['Git & GitHub', 30],
    ['CI/CD Pipelines', 30],
    ['Glasfaserausbau', 34],
    ['Netzplanung', 30],
    ['PHP', 30],
    ['Node.js', 30],
    ['Systemtests', 26],
    ['Refactoring', 26],
    ['Code Quality', 30],
    ['FastAPI', 30],
    ['Automatisierung', 34],
    ['Troubleshooting', 26],
    ['Prototyping', 30],

    // Micro / Accent Terms
    ['Kein Leerlauf', 28],
    ['Veränderung treiben', 28],
    ['Hohe Dynamik', 28],
    ['Komplexität meistern', 28],
    ['Neue Wege gehen', 28],
    ['Kommunikation', 30],
    ['Keine Monotonie', 26],
    ['Projekte parallel', 28],
    ['Zielstrebigkeit', 28],
    ['Objektive Fakten', 26],
    ['Konkrete Ergebnisse', 28],
    ['Führungsanspruch', 28],
    ['Direktes Handeln', 28],
    ['Unternehmensgeist', 28],
    ['Hoher Anspruch', 26],
    ['Wissenschaftlich', 26],
    ['Keine Grenzen', 24],
    ['Mut zum Risiko', 26],
    ['Humor & Freude', 26],
    ['Wert auf Leistung', 26],
    ['Faktenbasiert', 26],
    ['Verantwortung', 26],
    ['Praktischer Nutzen', 26],
    ['Kreative Impulse', 26],
    ['Tatkräftig', 28],
    ['Weitblick', 26],
    ['Performance-Fokus', 26],
    ['Clean Code', 28],
    ['User Experience', 26],
    ['Agile Methoden', 26],
    ['Selbstständigkeit', 28],
    ['Datenanalyse', 26],
    ['Problemlösungs-Drive', 28],
    ['Entschlossenheit', 28],
    ['Weiterentwicklung', 26],
    ['Hands-on', 28],
    ['Visionär', 28],
    ['Kreativpotenzial', 26],
    ['Effizienz steigern', 26],
    ['Starke Intuition', 28],
    ['Zukunftsorientiert', 28],
    ['Verlässlicher Partner', 26],
    ['Expertise', 26],
    ['Zielstrebig', 26],
    ['System-Optimierung', 26],
  ];

  const colors = [
    '#ef4444', // Red
    '#f59e0b', // Amber
    '#10b981', // Emerald
    '#06b6d4', // Cyan
    '#818cf8', // Indigo
    '#c084fc', // Purple
    '#f43f5e', // Rose
    '#38bdf8', // Sky
    '#22d3ee', // Cyan light
  ];

  function initInsideOutScrollWordCloud() {
    const container = document.querySelector<HTMLElement>('#wordcloud-container');
    const section = document.querySelector<HTMLElement>('#workstyle');
    if (!container || !section) return;

    // Clear existing DOM contents
    container.innerHTML = '';

    const width = Math.min(1280, container.clientWidth || window.innerWidth - 32);
    const height = 540;

    container.style.width = `${width}px`;
    container.style.height = `${height}px`;

    let sortedSpans: HTMLElement[] = [];

    // Render wordcloud once into DOM elements
    WordCloud(container, {
      list: fullWordList,
      shape: 'circle',
      gridSize: Math.round(8 * width / 1024),
      weightFactor: function (size) {
        return Math.pow(size, 1.2) * (width / 1100);
      },
      fontFamily: '"Inter Variable", Inter, system-ui, -apple-system, sans-serif',
      color: function () {
        return colors[Math.floor(Math.random() * colors.length)];
      },
      rotateRatio: 0.35,
      rotationSteps: 2,
      minRotation: -Math.PI / 2,
      maxRotation: 0,
      backgroundColor: 'transparent',
      drawOutOfBound: false,
      shrinkToFit: true,
    });

    // Listen for completion event when wordcloud DOM elements are rendered
    container.addEventListener('wordcloudstop', () => {
      const centerX = width / 2;
      const centerY = height / 2;

      const spans = Array.from(container.querySelectorAll<HTMLElement>('span'));
      
      // Calculate distance from center for each word element
      spans.forEach((span) => {
        const left = parseFloat(span.style.left) || (span.offsetLeft + span.offsetWidth / 2);
        const top = parseFloat(span.style.top) || (span.offsetTop + span.offsetHeight / 2);
        const dx = left - centerX;
        const dy = top - centerY;
        const dist = Math.hypot(dx, dy);

        span.dataset.distance = dist.toString();
        span.style.transition = 'opacity 0.4s ease-out, filter 0.4s ease-out, transform 0.4s ease-out';
        span.style.opacity = '0';
        span.style.filter = 'blur(6px)';
        span.style.transform = (span.style.transform || '') + ' scale(0.85)';
      });

      // Sort spans by distance from center ascending (center words first, outer words last)
      sortedSpans = spans.sort((a, b) => parseFloat(a.dataset.distance || '0') - parseFloat(b.dataset.distance || '0'));

      updateScrollProgress();
    });

    function updateScrollProgress() {
      if (!section || !sortedSpans.length) return;

      const rect = section.getBoundingClientRect();
      const totalScrollableHeight = rect.height - window.innerHeight;

      // Mobile or fallback: reveal all immediately
      if (window.innerWidth < 768 || totalScrollableHeight <= 0) {
        sortedSpans.forEach((span) => {
          span.style.opacity = '1';
          span.style.filter = 'none';
          span.style.transform = span.style.transform.replace(' scale(0.85)', '');
        });
        return;
      }

      const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));
      const activeCount = Math.floor(progress * (sortedSpans.length + 1));

      sortedSpans.forEach((span, idx) => {
        if (idx < activeCount) {
          span.style.opacity = '1';
          span.style.filter = 'none';
        } else {
          span.style.opacity = '0';
          span.style.filter = 'blur(6px)';
        }
      });
    }

    window.addEventListener('scroll', updateScrollProgress, { passive: true });
    window.addEventListener('resize', () => {
      initInsideOutScrollWordCloud();
    }, { passive: true });
  }

  initInsideOutScrollWordCloud();
  document.addEventListener('astro:page-load', initInsideOutScrollWordCloud);
</script>
