---
import { Brain, Sparkles } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

// Dense Organic Oval Cloud Array (Arranged from outer edges to central hero core)
const cloudWords = [
  // Outer Edge (Smaller Accent terms)
  { text: 'Glasfaserausbau', size: 'text-sm md:text-base font-mono', color: 'text-dim', orient: 'md:-rotate-90' },
  { text: 'Autodidaktik', size: 'text-lg md:text-2xl font-bold', color: 'text-indigo-400', orient: 'rotate-0' },
  { text: 'Prozessoptimierung', size: 'text-xs md:text-sm font-mono', color: 'text-dim', orient: 'rotate-0' },
  { text: 'Weitblick', size: 'text-base md:text-xl font-bold', color: 'text-cyan-300', orient: 'md:rotate-90' },
  { text: 'Flexibilität', size: 'text-lg md:text-2xl font-semibold', color: 'text-purple-300', orient: 'rotate-0' },

  // Inner Ring (Medium / Strong terms)
  { text: 'Kognitiver Wissensdurst', size: 'text-xl md:text-3xl font-extrabold', color: 'text-purple-400', orient: 'rotate-0' },
  { text: 'Entschlussfreude', size: 'text-2xl md:text-4xl font-extrabold', color: 'text-red-400', orient: 'md:-rotate-6' },
  { text: 'Analytische Präzision', size: 'text-xl md:text-3xl font-bold', color: 'text-cyan-400', orient: 'md:rotate-90' },

  // CORE CENTER HERO (Biggest, Boldest focal points of the cloud)
  { text: 'MOTIVATOR', size: 'text-5xl md:text-7xl font-black tracking-tight', color: 'text-red-500', orient: 'rotate-0' },
  { text: 'FÜHRUNGSSTÄRKE', size: 'text-4xl md:text-6xl font-black tracking-tight', color: 'text-amber-400', orient: 'md:-rotate-90' },
  { text: 'ORGANISATOR', size: 'text-5xl md:text-7xl font-black tracking-tight', color: 'text-amber-500', orient: 'rotate-0' },
  { text: 'TATKRAFT', size: 'text-4xl md:text-6xl font-black tracking-tight', color: 'text-emerald-400', orient: 'rotate-0' },

  // Inner Ring (Secondary bold terms)
  { text: 'Ergebnisorientiert', size: 'text-3xl md:text-5xl font-black', color: 'text-red-400', orient: 'rotate-0' },
  { text: 'Eigeninitiative', size: 'text-2xl md:text-4xl font-extrabold', color: 'text-cyan-300', orient: 'md:-rotate-90' },
  { text: 'Innovation', size: 'text-3xl md:text-5xl font-black', color: 'text-purple-400', orient: 'rotate-0' },
  { text: 'Begeisterung', size: 'text-xl md:text-3xl font-bold', color: 'text-emerald-300', orient: 'rotate-0' },

  // Outer Edge (Closing outer ring)
  { text: 'Strukturierte Umsetzung', size: 'text-2xl md:text-4xl font-bold', color: 'text-red-400', orient: 'rotate-0' },
  { text: 'Verlässlichkeit', size: 'text-lg md:text-2xl font-bold', color: 'text-amber-300', orient: 'md:rotate-6' },
  { text: 'Python & PHP', size: 'text-lg md:text-2xl font-extrabold', color: 'text-emerald-400', orient: 'md:-rotate-90' },
  { text: 'Aufgabenfokus', size: 'text-base md:text-xl font-bold', color: 'text-indigo-300', orient: 'rotate-0' },
  { text: 'Web-Apps', size: 'text-xl md:text-3xl font-bold', color: 'text-cyan-400', orient: 'rotate-0' },
];
---

<section id="workstyle" class="relative isolate border-t border-line md:min-h-[160vh]">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Central Cloud Glow Orb -->
  <div class="glow glow--violet glow--float left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] opacity-40 pointer-events-none" aria-hidden="true"></div>

  <!-- Sticky Content Wrapper -->
  <div class="container-page relative z-10 section-spacing md:sticky md:top-16 md:py-12">
    <!-- Header -->
    <div class="mb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-mono text-accent mb-3" data-reveal="up">
          <Brain class="size-3.5 text-accent" />
          <span>AECdisc® Stärken- & Potenzialwolke</span>
        </div>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          Arbeitsweise & Stärkenwolke.
        </h2>
        <p class="mt-2 text-base text-mute leading-relaxed" data-reveal="up" data-reveal-delay="0.1">
          Scrolle nach unten, um das Stärkenprofil Wort für Wort als dichte Wolke aufzubauen.
        </p>
      </div>

      <!-- Live Count Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/90 px-4 py-2 text-xs font-mono text-dim backdrop-blur-md shrink-0 shadow-md" data-reveal="up" data-reveal-delay="0.15">
        <Sparkles class="size-4 text-accent animate-pulse" />
        <span id="cloud-reveal-counter" class="text-ink font-semibold">0 / {cloudWords.length} Stärken geladen</span>
      </div>
    </div>

    <!-- FREELY FLOATING TIGHT DENSE OVAL CLOUD SILHOUETTE (No Card Box!) -->
    <div class="relative mx-auto max-w-5xl py-8 md:py-12 select-none text-center">
      <!-- Dense Interlocking Cloud Container -->
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 md:gap-x-5 md:gap-y-3 leading-none" id="workstyle-word-cloud">
        {
          cloudWords.map((word, i) => (
            <span
              data-cloud-index={i}
              class={`cloud-word inline-block ${word.size} ${word.color} ${word.orient} tracking-tight leading-none transition-all duration-700 ease-out cursor-default opacity-0 scale-60 translate-y-6 hover:scale-110 hover:z-30 hover:brightness-125`}
            >
              {word.text}
            </span>
          ))
        }
      </div>

      <!-- Bottom Profile Subtitle Tag -->
      <div class="mt-10 flex items-center justify-center gap-4 text-xs font-mono text-dim border-t border-line/40 pt-4 max-w-md mx-auto">
        <span>AECdisc® Potenzialanalyse</span>
        <span>·</span>
        <span class="text-ink font-semibold">Julius Hunold · Motivator & Organisator</span>
      </div>
    </div>
  </div>
</section>

<script>
  function initWordCloudScroll() {
    const section = document.querySelector<HTMLElement>('#workstyle');
    const words = document.querySelectorAll<HTMLElement>('.cloud-word');
    const counter = document.querySelector<HTMLElement>('#cloud-reveal-counter');

    if (!section || !words.length) return;

    function updateWordCloudProgress() {
      if (!section) return;

      const rect = section.getBoundingClientRect();
      const totalScrollableHeight = rect.height - window.innerHeight;

      // Mobile fallback: reveal all words immediately for smooth touch scrolling
      if (window.innerWidth < 768 || totalScrollableHeight <= 0) {
        words.forEach((w) => {
          w.style.opacity = '1';
          w.style.transform = 'scale(1) translateY(0)';
          w.style.filter = 'none';
        });
        if (counter) counter.textContent = `${words.length} / ${words.length} Stärken geladen`;
        return;
      }

      // Progress from 0 to 1 as user scrolls through section height
      const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));
      const activeCount = Math.floor(progress * (words.length + 1));

      words.forEach((word, idx) => {
        if (idx < activeCount) {
          word.style.opacity = '1';
          word.style.transform = 'scale(1) translateY(0)';
          word.style.filter = 'none';
        } else {
          word.style.opacity = '0';
          word.style.transform = 'scale(0.5) translateY(18px)';
          word.style.filter = 'blur(4px)';
        }
      });

      if (counter) {
        const currentRevealed = Math.min(words.length, activeCount);
        counter.textContent = `${currentRevealed} / ${words.length} Stärken geladen`;
      }
    }

    window.addEventListener('scroll', updateWordCloudProgress, { passive: true });
    updateWordCloudProgress();
  }

  initWordCloudScroll();
  document.addEventListener('astro:page-load', initWordCloudScroll);
</script>
