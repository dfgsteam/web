---
import { Brain, Target, Zap, Award, Sparkles, CheckCircle2 } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { PORTFOLIO_IMAGE } from '../../lib/site';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;
---

<section id="workstyle" class="section-spacing relative isolate overflow-hidden border-t border-line">
  <!-- Full-Width Parallax Scroll Background Image Overlay -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src={PORTFOLIO_IMAGE}
      alt="Julius Hunold Arbeitsweise Background"
      class="h-full w-full object-cover object-center opacity-15 blur-sm scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-base via-base/90 to-base"></div>
  </div>

  <!-- Ambient Glow Orbs -->
  <div class="glow glow--violet glow--float -right-32 top-10 h-[450px] w-[450px]" aria-hidden="true"></div>
  <div class="glow glow--sky glow--float-slow -left-32 bottom-0 h-[400px] w-[400px]" aria-hidden="true"></div>

  <div class="container-page relative z-10">
    <!-- Header -->
    <div class="mb-12 max-w-3xl">
      <p class="mb-3 text-xs uppercase tracking-widest text-accent font-mono" data-reveal="up">
        Persönlichkeitsprofil & Potenzialanalyse
      </p>
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        Arbeitsweise & Führungskompetenz.
      </h2>
      <p class="mt-4 text-base text-mute leading-relaxed" data-reveal="up" data-reveal-delay="0.1">
        Wissenschaftlich fundierte Verhaltensanalyse trifft auf pragmatische Umsetzung – das Persönlichkeitsprofil laut offizieller AECdisc® Potenzialanalyse.
      </p>
    </div>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-stretch">

      <!-- Left Hero Image Card (4 Spalten) -->
      <div class="lg:col-span-4 relative group rounded-3xl overflow-hidden border border-line bg-surface/80 p-3 shadow-2xl backdrop-blur-md" data-reveal="up">
        <div class="relative h-full min-h-[340px] w-full rounded-2xl overflow-hidden">
          <img
            src={PORTFOLIO_IMAGE}
            alt="Julius Hunold Profile"
            class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
          
          <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-surface/80 border border-white/10 backdrop-blur-md">
            <span class="block text-xs font-mono text-accent uppercase tracking-wider">AECdisc® Haupttyp</span>
            <span class="block text-lg font-bold text-white">MOTIVATOR & ORGANISATOR</span>
            <span class="block text-[11px] text-gray-300 mt-0.5">Pos. 12 (Natürlich) · Pos. 9 (Angepasst)</span>
          </div>
        </div>
      </div>

      <!-- Right Insights Grid (8 Spalten) -->
      <div class="lg:col-span-8 flex flex-col justify-between gap-6" data-reveal="up" data-reveal-delay="0.15">

        <!-- Top Overview Glass Card -->
        <div class="rounded-3xl border border-line bg-surface/90 p-7 md:p-8 shadow-xl backdrop-blur-md">
          <div class="flex items-center gap-2 mb-3">
            <Brain class="size-5 text-accent" />
            <h3 class="text-xl font-bold text-ink">Verhaltens- & Leistungsmuster</h3>
          </div>
          <p class="text-sm text-mute leading-relaxed">
            Julius kombiniert die **Begeisterungsfähigkeit und Führungskraft des Motivators** mit der **strukturierten Präzision des Organisators**. Diese Synthese ermöglicht es ihm, anspruchsvolle Software- & Ausbauprojekte mit klarer Vision zu starten und diszipliniert ins Ziel zu steuern.
          </p>

          <!-- 4 Score Cards -->
          <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="rounded-2xl border border-line bg-base/90 p-3.5 text-center shadow-inner">
              <span class="block text-2xl font-black text-accent font-mono">71 / 100</span>
              <span class="block text-[11px] font-mono text-dim mt-0.5">Kognitives Motiv</span>
            </div>
            <div class="rounded-2xl border border-line bg-base/90 p-3.5 text-center shadow-inner">
              <span class="block text-2xl font-black text-cyan-400 font-mono">76 %</span>
              <span class="block text-[11px] font-mono text-dim mt-0.5">Rot (Tatkraft)</span>
            </div>
            <div class="rounded-2xl border border-line bg-base/90 p-3.5 text-center shadow-inner">
              <span class="block text-2xl font-black text-amber-400 font-mono">73 %</span>
              <span class="block text-[11px] font-mono text-dim mt-0.5">Gelb (Einfluss)</span>
            </div>
            <div class="rounded-2xl border border-line bg-base/90 p-3.5 text-center shadow-inner">
              <span class="block text-2xl font-black text-purple-400 font-mono">77 %</span>
              <span class="block text-[11px] font-mono text-dim mt-0.5">Dringlichkeit & Führung</span>
            </div>
          </div>
        </div>

        <!-- Bottom 3 Pillars Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-2xl border border-line bg-surface/80 p-5 backdrop-blur-md">
            <div class="flex items-center gap-2 mb-2 text-ink font-bold text-sm">
              <Target class="size-4 text-accent" />
              <span>Analytische Tiefe</span>
            </div>
            <p class="text-xs text-mute leading-relaxed">
              Starker Wissensdurst (Kognitiv 71) & schnelle Einarbeitung in komplexe Technologien und Datenmodelle.
            </p>
          </div>

          <div class="rounded-2xl border border-line bg-surface/80 p-5 backdrop-blur-md">
            <div class="flex items-center gap-2 mb-2 text-ink font-bold text-sm">
              <Zap class="size-4 text-cyan-400" />
              <span>Zielorientierung</span>
            </div>
            <p class="text-xs text-mute leading-relaxed">
              Hohe Entschlussfreude (Rot 76%) – packt Herausforderungen direkt ohne Leerlauf an.
            </p>
          </div>

          <div class="rounded-2xl border border-line bg-surface/80 p-5 backdrop-blur-md">
            <div class="flex items-center gap-2 mb-2 text-ink font-bold text-sm">
              <Award class="size-4 text-purple-400" />
              <span>Kommunikation</span>
            </div>
            <p class="text-xs text-mute leading-relaxed">
              Klare Vermittlung (Gelb 73%) an der Schnittstelle zwischen Tech-Teams, Vorgesetzten und Kunden.
            </p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
