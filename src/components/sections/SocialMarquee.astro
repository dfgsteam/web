---
import { Globe, Cpu, Leaf, Mail, Download } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

const brandLogos = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/julius-hunold/',
    hoverColor: 'hover:text-[#0A66C2]',
    svg: `<svg class="h-6 w-auto fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>`,
  },
  {
    name: 'GitHub',
    url: 'https://github.com/juliushunold',
    hoverColor: 'hover:text-[#2DBA4E]',
    svg: `<svg class="h-6 w-auto fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
  {
    name: 'XING',
    url: 'https://www.xing.com/profile/Julius_Hunold',
    hoverColor: 'hover:text-[#006567]',
    svg: `<svg class="h-6 w-auto fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.188 0c-.517 0-.741.325-.927.663l-6.45 11.462 4.11 7.425c.174.325.42.663.927.663h3.513c.427 0 .618-.288.441-.613l-3.86-6.95 6.07-10.787c.177-.325-.014-.613-.441-.613h-3.386zm-11.83 4.887c-.427 0-.645.288-.469.613l2.298 4.103-3.666 6.462c-.177.325.014.613.441.613h3.407c.517 0 .741-.325.927-.663l3.86-6.8-2.52-4.513c-.174-.325-.42-.613-.927-.613h-3.352z"/></svg>`,
  },
  {
    name: 'hnld.de',
    url: 'https://hnld.de',
    hoverColor: 'hover:text-cyan-400',
    icon: Globe,
  },
  {
    name: 'hunold24.de',
    url: 'https://hunold24.de',
    hoverColor: 'hover:text-blue-400',
    icon: Cpu,
  },
  {
    name: 'ennery',
    url: 'https://ennery.de',
    hoverColor: 'hover:text-emerald-400',
    icon: Leaf,
  },
  {
    name: 'X / Twitter',
    url: 'https://x.com',
    hoverColor: 'hover:text-white',
    svg: `<svg class="h-5 w-auto fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
  {
    name: 'vCard .vcf',
    url: '/julius-hunold.vcf',
    download: true,
    hoverColor: 'hover:text-amber-400',
    icon: Download,
  },
];
---

<section class="relative isolate overflow-hidden border-y border-line bg-surface/40 py-7 backdrop-blur-md">
  <div class="marquee relative overflow-hidden" data-reveal="up">
    <div class="marquee-track flex items-center gap-14 hover:[animation-play-state:paused]" style="animation-duration: 26s;">
      <!-- Track 1 -->
      <div class="flex items-center gap-14 pr-14">
        {
          brandLogos.map((brand) => {
            const Icon = brand.icon;
            return (
              <a
                href={brand.url}
                target={brand.download ? '_self' : '_blank'}
                rel={brand.download ? undefined : 'noopener noreferrer'}
                download={brand.download ? true : undefined}
                class={`group flex items-center gap-3 text-mute transition-all duration-300 ${brand.hoverColor} hover:scale-105 shrink-0 opacity-75 hover:opacity-100`}
                title={brand.name}
              >
                {brand.svg ? (
                  <Fragment set:html={brand.svg} />
                ) : Icon ? (
                  <Icon class="size-5 shrink-0" stroke-width={1.75} />
                ) : null}
                <span class="text-sm font-semibold tracking-tight text-ink group-hover:text-current transition-colors">
                  {brand.name}
                </span>
              </a>
            );
          })
        }
      </div>

      <!-- Track 2 (Duplicate for Infinite Loop) -->
      <div class="flex items-center gap-14 pr-14" aria-hidden="true">
        {
          brandLogos.map((brand) => {
            const Icon = brand.icon;
            return (
              <a
                href={brand.url}
                target={brand.download ? '_self' : '_blank'}
                rel={brand.download ? undefined : 'noopener noreferrer'}
                download={brand.download ? true : undefined}
                tabindex="-1"
                class={`group flex items-center gap-3 text-mute transition-all duration-300 ${brand.hoverColor} hover:scale-105 shrink-0 opacity-75 hover:opacity-100`}
                title={brand.name}
              >
                {brand.svg ? (
                  <Fragment set:html={brand.svg} />
                ) : Icon ? (
                  <Icon class="size-5 shrink-0" stroke-width={1.75} />
                ) : null}
                <span class="text-sm font-semibold tracking-tight text-ink group-hover:text-current transition-colors">
                  {brand.name}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
