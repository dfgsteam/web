---
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

// Official Brand Logos uploaded by user (Slightly larger sizing)
const baseBrandLogos = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/julius-hunold-b3a669151/',
    imgSrc: '/images/logos/linkedin.png',
    heightClass: 'h-8 sm:h-9 w-auto object-contain',
    label: undefined,
  },
  {
    name: 'XING',
    url: 'https://www.xing.com/profile/Julius_Hunold022203',
    imgSrc: '/images/logos/xing.png',
    heightClass: 'h-8 sm:h-9 w-auto object-contain',
    label: undefined,
  },
  {
    name: 'hunold24',
    url: 'https://hunold24.de',
    imgSrc: '/images/logos/hunold24.png',
    heightClass: 'h-9 sm:h-10 w-auto object-contain dark:brightness-200',
    label: undefined,
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/julius.hunold',
    imgSrc: '/images/logos/instagram.png',
    heightClass: 'h-8 sm:h-9 w-auto object-contain',
    label: 'Instagram',
  },
  {
    name: 'Twitter / X',
    url: 'https://x.com',
    imgSrc: '/images/logos/x.png',
    heightClass: 'h-7 sm:h-8 w-auto object-contain dark:invert',
    label: 'Twitter / X',
  },
  {
    name: 'GitHub',
    url: 'https://github.com/dfgsteam',
    svg: `<svg class="h-8 sm:h-9 w-auto fill-current text-ink" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 0C7.16 0 0 7.16 0 16c0 7.07 4.58 13.07 10.94 15.19.8.15 1.09-.35 1.09-.77 0-.38-.01-1.39-.02-2.73-4.45.97-5.39-2.14-5.39-2.14-.73-1.85-1.78-2.34-1.78-2.34-1.45-.99.11-.97.11-.97 1.6.11 2.45 1.64 2.45 1.64 1.43 2.45 3.75 1.74 4.66 1.33.15-1.04.56-1.74 1.02-2.14-3.55-.4-7.29-1.78-7.29-7.91 0-1.75.62-3.18 1.64-4.3-.16-.4-.71-2.03.16-4.24 0 0 1.35-.43 4.42 1.64a15.3 15.3 0 0 1 4.02-.54c1.36.01 2.73.18 4.02.54 3.07-2.07 4.42-1.64 4.42-1.64.87 2.21.32 3.84.16 4.24 1.02 1.12 1.64 2.55 1.64 4.3 0 6.15-3.75 7.5-7.32 7.9.58.5 1.09 1.48 1.09 2.98 0 2.15-.02 3.89-.02 4.41 0 .43.29.93 1.1 0.77C27.42 29.07 32 23.07 32 16 32 7.16 24.84 0 16 0z"/>
      <text x="38" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="700" font-size="21" letter-spacing="-0.5">GitHub</text>
    </svg>`,
    label: undefined,
  },
  {
    name: 'hnld.de',
    url: 'https://hnld.de',
    svg: `<svg class="h-8 sm:h-9 w-auto fill-current text-cyan-400" viewBox="0 0 110 32" xmlns="http://www.w3.org/2000/svg">
      <rect x="0" y="4" width="24" height="24" rx="7" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="2"/>
      <text x="6" y="21" font-family="monospace" font-weight="900" font-size="13" fill="currentColor">H</text>
      <text x="32" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="800" font-size="21" letter-spacing="-0.5" fill="currentColor">hnld<tspan font-weight="400" fill-opacity="0.6">.de</tspan></text>
    </svg>`,
    label: undefined,
  },
  {
    name: 'ennery',
    url: 'https://ennery.de',
    imgSrc: '/images/logos/ennery.png',
    heightClass: 'h-7 sm:h-8 w-auto object-contain dark:invert',
    label: undefined,
  },
];

// Multiply logos so track width is > 3000px, eliminating wide-screen gaps
const brandLogos = [...baseBrandLogos, ...baseBrandLogos, ...baseBrandLogos];
---

<section class="marquee relative overflow-hidden border-y border-line bg-gradient-to-r from-accent/10 via-accent-2/10 to-amber-400/10 py-6">
  <div class="marquee-track flex items-center gap-7 hover:[animation-play-state:paused]" style="--marquee-speed: 38s;" data-reveal="up">
    <!-- Track 1 -->
    <div class="flex items-center gap-7 pr-7 shrink-0">
      {
        brandLogos.map((brand) => (
          <a
            href={brand.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3.5 rounded-2xl border border-line/60 bg-surface/80 px-5 py-3 backdrop-blur-md shadow-xs transition-all duration-300 hover:scale-105 hover:border-accent hover:bg-surface hover:shadow-lg hover:shadow-accent/10 shrink-0"
            title={brand.name}
          >
            {brand.imgSrc ? (
              <img
                src={brand.imgSrc}
                alt={brand.name}
                class={brand.heightClass}
                loading="lazy"
              />
            ) : brand.svg ? (
              <Fragment set:html={brand.svg} />
            ) : null}

            {brand.label && (
              <span class="text-sm font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                {brand.label}
              </span>
            )}
          </a>
        ))
      }
    </div>

    <!-- Track 2 (Identical Copy for 100% Seamless Gapless Loop) -->
    <div class="flex items-center gap-7 pr-7 shrink-0" aria-hidden="true">
      {
        brandLogos.map((brand) => (
          <a
            href={brand.url}
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="group flex items-center gap-3.5 rounded-2xl border border-line/60 bg-surface/80 px-5 py-3 backdrop-blur-md shadow-xs transition-all duration-300 hover:scale-105 hover:border-accent hover:bg-surface hover:shadow-lg hover:shadow-accent/10 shrink-0"
            title={brand.name}
          >
            {brand.imgSrc ? (
              <img
                src={brand.imgSrc}
                alt={brand.name}
                class={brand.heightClass}
                loading="lazy"
              />
            ) : brand.svg ? (
              <Fragment set:html={brand.svg} />
            ) : null}

            {brand.label && (
              <span class="text-sm font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                {brand.label}
              </span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>
