---

<section class="relative isolate overflow-hidden border-y border-line bg-surface/50 py-7 backdrop-blur-md">
  <div class="marquee relative overflow-hidden" data-reveal="up">
    <div class="marquee-track flex items-center gap-6 hover:[animation-play-state:paused]" style="animation-duration: 30s;">
      <!-- Track 1 -->
      <div class="flex items-center gap-6 pr-6">
        {
          brandLogos.map((brand) => (
            <a
              href={brand.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-2xl border border-line bg-surface/80 px-4 py-2.5 backdrop-blur-md shadow-xs transition-all duration-300 hover:scale-105 hover:border-accent/50 hover:bg-surface hover:shadow-lg hover:shadow-accent/5 shrink-0"
              title={brand.name}
            >
              <Fragment set:html={brand.svg} />

              {brand.label && (
                <span class="text-sm font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                  {brand.label}
                </span>
              )}
            </a>
          ))
        }
      </div>

      <!-- Track 2 (Duplicate for Seamless Infinite Loop) -->
      <div class="flex items-center gap-6 pr-6" aria-hidden="true">
        {
          brandLogos.map((brand) => (
            <a
              href={brand.url}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              class="group flex items-center gap-3 rounded-2xl border border-line bg-surface/80 px-4 py-2.5 backdrop-blur-md shadow-xs transition-all duration-300 hover:scale-105 hover:border-accent/50 hover:bg-surface hover:shadow-lg hover:shadow-accent/5 shrink-0"
              title={brand.name}
            >
              <Fragment set:html={brand.svg} />

              {brand.label && (
                <span class="text-sm font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                  {brand.label}
                </span>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
