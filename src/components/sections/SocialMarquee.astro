---
import { ExternalLink, Globe, Mail, Download, Leaf, Cpu, Sparkles, UserCheck } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

const profiles = [
  {
    name: 'LinkedIn',
    handle: 'Julius Hunold',
    url: 'https://www.linkedin.com/in/julius-hunold/',
    icon: ExternalLink,
    badge: 'Netzwerk',
    color: 'from-blue-500/20 to-sky-500/20 text-sky-400 border-sky-500/30',
    dot: 'bg-sky-400',
  },
  {
    name: 'GitHub',
    handle: '@juliushunold',
    url: 'https://github.com/juliushunold',
    icon: Globe,
    badge: 'Code Repository',
    color: 'from-emerald-500/20 to-teal-500/20 text-emerald-400 border-emerald-500/30',
    dot: 'bg-emerald-400',
  },
  {
    name: 'XING',
    handle: 'Julius Hunold',
    url: 'https://www.xing.com/profile/Julius_Hunold',
    icon: UserCheck,
    badge: 'Business Profil',
    color: 'from-teal-600/20 to-emerald-600/20 text-teal-400 border-teal-500/30',
    dot: 'bg-teal-400',
  },
  {
    name: 'hnld.de',
    handle: 'Webdesign Studio',
    url: 'https://hnld.de',
    icon: Globe,
    badge: 'Studio',
    color: 'from-cyan-500/20 to-blue-500/20 text-cyan-400 border-cyan-500/30',
    dot: 'bg-cyan-400',
  },
  {
    name: 'hunold24.de',
    handle: 'Custom Web-Apps',
    url: 'https://hunold24.de',
    icon: Cpu,
    badge: 'Web & Tech',
    color: 'from-blue-600/20 to-indigo-600/20 text-blue-400 border-blue-500/30',
    dot: 'bg-blue-400',
  },
  {
    name: 'ennery',
    handle: 'Energy Software',
    url: 'https://ennery.de',
    icon: Leaf,
    badge: 'CleanTech',
    color: 'from-emerald-500/20 to-green-500/20 text-emerald-400 border-emerald-500/30',
    dot: 'bg-emerald-400',
  },
  {
    name: 'E-Mail',
    handle: 'info@julius-hunold.de',
    url: 'mailto:info@julius-hunold.de',
    icon: Mail,
    badge: 'Direktkontakt',
    color: 'from-violet-500/20 to-purple-500/20 text-violet-400 border-violet-500/30',
    dot: 'bg-violet-400',
  },
  {
    name: 'vCard',
    handle: 'Download .vcf',
    url: '/julius-hunold.vcf',
    download: true,
    icon: Download,
    badge: 'Recruiter Card',
    color: 'from-amber-500/20 to-orange-500/20 text-amber-400 border-amber-500/30',
    dot: 'bg-amber-400',
  },
];
---

<section class="relative isolate overflow-hidden border-t border-line py-12 bg-base/50">
  <!-- Subtle Ambient Header -->
  <div class="container-page mb-6 text-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1 text-xs font-mono uppercase tracking-widest text-dim backdrop-blur-md">
      <Sparkles class="size-3.5 text-accent" />
      <span>{t.socialMarquee?.label ?? 'Profile & Netzwerke'}</span>
    </div>
  </div>

  <!-- Marquee Container with Pausing Hover -->
  <div class="marquee relative overflow-hidden py-3" data-reveal="up">
    <div class="marquee-track flex items-center hover:[animation-play-state:paused]" style="animation-duration: 32s;">
      <!-- Track 1 -->
      <div class="flex items-center gap-4 pr-4">
        {
          profiles.map((profile) => {
            const Icon = profile.icon;
            return (
              <a
                href={profile.url}
                target={profile.download ? '_self' : '_blank'}
                rel={profile.download ? undefined : 'noopener noreferrer'}
                download={profile.download ? true : undefined}
                class="group flex items-center gap-3.5 rounded-2xl border border-line bg-surface/90 px-4 py-3 backdrop-blur-md transition-all duration-300 hover:border-accent/60 hover:bg-surface hover:shadow-lg hover:shadow-accent/5 hover:-translate-y-0.5 shrink-0"
              >
                <div class={`flex size-9 items-center justify-center rounded-xl bg-gradient-to-br ${profile.color} border transition-transform duration-300 group-hover:scale-110`}>
                  <Icon class="size-4 shrink-0" stroke-width={1.75} />
                </div>
                <div class="flex flex-col">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                      {profile.name}
                    </span>
                    <span class={`size-1.5 rounded-full ${profile.dot}`} aria-hidden="true"></span>
                  </div>
                  <span class="text-[11px] text-mute font-mono">
                    {profile.handle}
                  </span>
                </div>
                <ExternalLink class="size-3.5 text-dim group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300 ml-1" />
              </a>
            );
          })
        }
      </div>

      <!-- Track 2 (Duplicate for Seamless Infinite Loop) -->
      <div class="flex items-center gap-4 pr-4" aria-hidden="true">
        {
          profiles.map((profile) => {
            const Icon = profile.icon;
            return (
              <a
                href={profile.url}
                target={profile.download ? '_self' : '_blank'}
                rel={profile.download ? undefined : 'noopener noreferrer'}
                download={profile.download ? true : undefined}
                tabindex="-1"
                class="group flex items-center gap-3.5 rounded-2xl border border-line bg-surface/90 px-4 py-3 backdrop-blur-md transition-all duration-300 hover:border-accent/60 hover:bg-surface hover:shadow-lg hover:shadow-accent/5 hover:-translate-y-0.5 shrink-0"
              >
                <div class={`flex size-9 items-center justify-center rounded-xl bg-gradient-to-br ${profile.color} border transition-transform duration-300 group-hover:scale-110`}>
                  <Icon class="size-4 shrink-0" stroke-width={1.75} />
                </div>
                <div class="flex flex-col">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                      {profile.name}
                    </span>
                    <span class={`size-1.5 rounded-full ${profile.dot}`} aria-hidden="true"></span>
                  </div>
                  <span class="text-[11px] text-mute font-mono">
                    {profile.handle}
                  </span>
                </div>
                <ExternalLink class="size-3.5 text-dim group-hover:text-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300 ml-1" />
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>
