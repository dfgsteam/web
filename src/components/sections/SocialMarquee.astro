---
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

// Official Full Brand Logotypes (SVG containing Logo Icon + Official Brand Typography Wordmark)
const brandLogos = [
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/julius-hunold/',
    hoverColor: 'hover:text-[#0A66C2]',
    // Official LinkedIn Full Logo (Icon + "LinkedIn" typography)
    svg: `<svg class="h-7 w-auto fill-current" viewBox="0 0 134 34" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 31.321h6.634V9.923H0v21.398zM3.317.001C1.488.001 0 1.489 0 3.317c0 1.828 1.488 3.364 3.317 3.364 1.829 0 3.317-1.536 3.317-3.364C6.634 1.489 5.146.001 3.317.001zM42.146 31.321h6.634V18.179c0-7.039-3.758-10.312-8.767-10.312-4.041 0-5.85 2.227-6.86 3.791v-3.257h-6.634c.088 1.874 0 21.398 0 21.398h6.634v-11.95c0-.639.046-1.278.234-1.737.514-1.278 1.685-2.604 3.652-2.604 2.576 0 3.606 1.961 3.606 4.834v11.457zM11.66 31.321h6.634V9.923h-6.634v21.398zM24.819 23.368c.002-3.876 2.05-6.027 5.127-6.027 1.869 0 3.011.895 3.518 1.691v-9.109h-6.634v4.04c-.958-1.428-2.695-2.42-5.328-2.42-4.908 0-8.621 3.861-8.621 10.36 0 6.406 3.607 10.22 8.48 10.22 2.766 0 4.606-1.127 5.469-2.564v2.062h6.634v-8.253h-8.645zm-1.89 2.518c-2.316 0-3.957-1.79-3.957-4.654 0-2.887 1.664-4.701 3.98-4.701 2.292 0 3.934 1.814 3.934 4.701 0 2.864-1.642 4.654-3.957 4.654z"/>
      <g transform="translate(56, 0)">
        <path d="M72 0H6a6 6 0 0 0-6 6v60a6 6 0 0 0 6 6h66a6 6 0 0 0 6-6V6a6 6 0 0 0-6-6zM22 62H11V27h11v35zm-5.5-40a6.5 6.5 0 1 1 0-13 6.5 6.5 0 0 1 0 13zM67 62H56V43.5c0-4.7-1.7-7.9-5.9-7.9-3.2 0-5.1 2.2-5.9 4.3-.3.7-.4 1.7-.4 2.7V62H33s.1-32 0-35h11v5c1.5-2.2 4.1-5.4 9.8-5.4 7.2 0 13.2 4.7 13.2 15.1V62z" transform="scale(0.421)"/>
