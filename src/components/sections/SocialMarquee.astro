  },
  {
    name: 'GitHub',
    url: 'https://github.com/juliushunold',
    hoverColor: 'hover:text-[#2DBA4E]',
    // Official GitHub Full Logo (Octocat + "GitHub" typography wordmark)
    svg: `<svg class="h-7 w-auto fill-current" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 0C7.16 0 0 7.16 0 16c0 7.07 4.58 13.07 10.94 15.19.8.15 1.09-.35 1.09-.77 0-.38-.01-1.39-.02-2.73-4.45.97-5.39-2.14-5.39-2.14-.73-1.85-1.78-2.34-1.78-2.34-1.45-.99.11-.97.11-.97 1.6.11 2.45 1.64 2.45 1.64 1.43 2.45 3.75 1.74 4.66 1.33.15-1.04.56-1.74 1.02-2.14-3.55-.4-7.29-1.78-7.29-7.91 0-1.75.62-3.18 1.64-4.3-.16-.4-.71-2.03.16-4.24 0 0 1.35-.43 4.42 1.64a15.3 15.3 0 0 1 4.02-.54c1.36.01 2.73.18 4.02.54 3.07-2.07 4.42-1.64 4.42-1.64.87 2.21.32 3.84.16 4.24 1.02 1.12 1.64 2.55 1.64 4.3 0 6.15-3.75 7.5-7.32 7.9.58.5 1.09 1.48 1.09 2.98 0 2.15-.02 3.89-.02 4.41 0 .43.29.93 1.1 0.77C27.42 29.07 32 23.07 32 16 32 7.16 24.84 0 16 0z"/>
      <text x="38" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-weight="700" font-size="21" letter-spacing="-0.5">GitHub</text>
    </svg>`,
  },
  {
    name: 'XING',
    url: 'https://www.xing.com/profile/Julius_Hunold',
    hoverColor: 'hover:text-[#006567]',
    // Official XING Full Logo (XING Double-X + "XING" typography wordmark)
    svg: `<svg class="h-7 w-auto fill-current" viewBox="0 0 110 32" xmlns="http://www.w3.org/2000/svg">
      <path d="M18.188 0c-.517 0-.741.325-.927.663l-6.45 11.462 4.11 7.425c.174.325.42.663.927.663h3.513c.427 0 .618-.288.441-.613l-3.86-6.95 6.07-10.787c.177-.325-.014-.613-.441-.613h-3.386zm-11.83 4.887c-.427 0-.645.288-.469.613l2.298 4.103-3.666 6.462c-.177.325.014.613.441.613h3.407c.517 0 .741-.325.927-.663l3.86-6.8-2.52-4.513c-.174-.325-.42-.613-.927-.613h-3.352z" transform="translate(0, 4) scale(1.1)"/>
      <text x="32" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="800" font-size="22" letter-spacing="0.5">XING</text>
    </svg>`,
  },
  {
    name: 'hnld.de',
    url: 'https://hnld.de',
    hoverColor: 'hover:text-cyan-400',
    // hnld.de Official Studio Wordmark SVG
    svg: `<svg class="h-7 w-auto fill-current text-cyan-400" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg">
      <rect x="0" y="4" width="24" height="24" rx="7" fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="2"/>
      <text x="6" y="21" font-family="monospace" font-weight="900" font-size="13" fill="currentColor">H</text>
      <text x="32" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="800" font-size="21" letter-spacing="-0.5">hnld<tspan font-weight="400" fill-opacity="0.6">.de</tspan></text>
    </svg>`,
  },
  {
    name: 'hunold24.de',
    url: 'https://hunold24.de',
    hoverColor: 'hover:text-blue-400',
    // hunold24.de Windows XP / Tech Wordmark SVG
    svg: `<svg class="h-7 w-auto fill-current text-blue-400" viewBox="0 0 150 32" xmlns="http://www.w3.org/2000/svg">
      <path d="M0 6a2 2 0 0 1 2-2h20a2 2 0 0 1 2 2v20a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V6zm2 2v4h20V8H2zm0 6v10h20V14H2z" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.5"/>
      <text x="30" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="800" font-size="20" letter-spacing="-0.5">hunold<tspan font-weight="900" fill="#3B82F6">24</tspan><tspan font-weight="400" fill-opacity="0.6">.de</tspan></text>
    </svg>`,
  },
  {
    name: 'ennery',
    url: 'https://ennery.de',
    hoverColor: 'hover:text-emerald-400',
    // ennery CleanTech Energy Wordmark SVG
    svg: `<svg class="h-7 w-auto fill-current text-emerald-400" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z" fill="currentColor" fill-opacity="0.2" transform="translate(0, 4) scale(1)"/>
      <text x="28" y="23" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-weight="800" font-size="22" letter-spacing="-0.5">ennery<tspan font-size="12" font-weight="500" fill="currentColor" fill-opacity="0.7">.de</tspan></text>
    </svg>`,
  },
  {
    name: 'X (Twitter)',
    url: 'https://x.com',
    hoverColor: 'hover:text-white',
    // Official X Logo Mark SVG
    svg: `<svg class="h-6 w-auto fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>`,
  },
];
---

<section class="relative isolate overflow-hidden border-y border-line bg-surface/40 py-8 backdrop-blur-md">
  <div class="marquee relative overflow-hidden" data-reveal="up">
    <div class="marquee-track flex items-center gap-16 hover:[animation-play-state:paused]" style="animation-duration: 28s;">
      <!-- Track 1 -->
      <div class="flex items-center gap-16 pr-16">
        {
          brandLogos.map((brand) => (
            <a
              href={brand.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`group flex items-center text-mute transition-all duration-300 ${brand.hoverColor} hover:scale-110 shrink-0 opacity-80 hover:opacity-100`}
              title={brand.name}
            >
              <Fragment set:html={brand.svg} />
            </a>
          ))
        }
      </div>

      <!-- Track 2 (Duplicate for Infinite Loop) -->
      <div class="flex items-center gap-16 pr-16" aria-hidden="true">
        {
          brandLogos.map((brand) => (
            <a
              href={brand.url}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
              class={`group flex items-center text-mute transition-all duration-300 ${brand.hoverColor} hover:scale-110 shrink-0 opacity-80 hover:opacity-100`}
              title={brand.name}
            >
              <Fragment set:html={brand.svg} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
