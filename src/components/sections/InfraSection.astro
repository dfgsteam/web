---
import { Box, GitBranch, ShieldCheck, RefreshCw, Server, Zap, Terminal, Check, Database, Lock, HardDrive, CheckCircle2 } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

const featureIcons = [Box, GitBranch, ShieldCheck, RefreshCw, Server, Zap];

const nodes = [
  { name: 'docker3.infra', role: 'Nginx Proxy Manager, Symfony App, Auth & Redis Broker', ip: '10.0.4.3', status: t.infra.status.online, load: '16%' },
  { name: 'docker4.infra', role: 'PostgreSQL DB Cluster & MinIO S3 Object Storage', ip: '10.0.4.4', status: t.infra.status.online, load: '22%' },
];

const serviceNodes = [
  {
    step: '01',
    name: 'Symfony Web-App',
    role: 'PHP 8.3 FPM & Nginx',
    desc: 'Empfängt HTTP-Anfragen, rendert Benutzeroberflächen und steuert die zentralen API-Endpunkte.',
    tech: 'Symfony 7 • PHP FPM',
    time: '4ms',
    icon: Server,
    badgeColor: 'border-amber-500/30 text-amber-400 bg-amber-500/10',
    dotColor: 'bg-amber-400 shadow-amber-500/50',
  },
  {
    step: '02',
    name: 'Auth-Server (OAuth2)',
    role: 'Keycloak / JWT Security',
    desc: 'Regelt die zentrale Authentifizierung, prüft Zugriffsrechte und stellt sichere Session-Tokens aus.',
    tech: 'OAuth2 • JWT Security',
    time: '7ms',
    icon: Lock,
    badgeColor: 'border-sky-500/30 text-sky-400 bg-sky-500/10',
    dotColor: 'bg-sky-400 shadow-sky-500/50',
  },
  {
    step: '03',
    name: 'Redis Cache & Broker',
    role: 'In-Memory Speicher',
    desc: 'Speichert Daten im Arbeitsspeicher für blitzschnelle Ladezeiten und steuert die Message-Queue.',
    tech: 'Redis 7 • Cache Broker',
    time: '9ms',
    icon: Zap,
    badgeColor: 'border-violet-500/30 text-violet-400 bg-violet-500/10',
    dotColor: 'bg-violet-400 shadow-violet-500/50',
  },
  {
    step: '04',
    name: 'Symfony Messenger',
    role: 'Async Background Worker',
    desc: 'Führt zeitintensive Hintergrund-Jobs (z. B. E-Mail-Versand, Exporte) vollautomatisch aus.',
    tech: 'Symfony Messenger',
    time: '12ms',
    icon: RefreshCw,
    badgeColor: 'border-purple-500/30 text-purple-400 bg-purple-500/10',
    dotColor: 'bg-purple-400 shadow-purple-500/50',
  },
  {
    step: '05',
    name: 'PostgreSQL Datenbank',
    role: 'Relationaler DB-Cluster',
    desc: 'Speichert alle Struktur- und Geschäftsdaten (Nutzer, Bestellungen, Inhalte) dauerhaft und sicher.',
    tech: 'PostgreSQL 16 • Doctrine',
    time: '15ms',
    icon: Database,
    badgeColor: 'border-indigo-500/30 text-indigo-400 bg-indigo-500/10',
    dotColor: 'bg-indigo-400 shadow-indigo-500/50',
  },
  {
    step: '06',
    name: 'S3 Object Storage',
    role: 'MinIO Cloud-Dateispeicher',
    desc: 'Verwaltet Medien, Bild-Uploads, Rechnungen und Backups in einem hochskalierbaren S3-Bucket.',
    tech: 'MinIO S3 • Cloud Storage',
    time: '18ms',
    icon: HardDrive,
    badgeColor: 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10',
    dotColor: 'bg-emerald-400 shadow-emerald-500/50',
  },
];
---

<section id="infra" class="section-spacing relative isolate overflow-hidden">
  <!-- Glowing Background Orbs -->
  <div class="glow glow--emerald -left-40 top-1/3 h-[460px] w-[460px]" aria-hidden="true"></div>
  <div class="glow glow--violet glow--float-slow -right-32 bottom-10 h-[400px] w-[400px]" aria-hidden="true"></div>

  <div class="container-page relative">
    <!-- Header -->
    <div class="max-w-3xl">
      <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
        {t.infra.label}
      </p>
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        {t.infra.heading}
      </h2>
      <p class="mt-5 text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
        {t.infra.subheading}
      </p>
    </div>

    <!-- Active Nodes Badge Bar -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-2" data-reveal="up" data-reveal-delay="0.15">
      {
        nodes.map((node) => (
          <div class="flex items-center justify-between rounded-2xl border border-line bg-surface/80 px-6 py-4 backdrop-blur-md transition-all duration-300 hover:border-emerald-500/40">
            <div class="flex items-center gap-3.5">
              <span class="relative flex size-3">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex size-3 rounded-full bg-emerald-500"></span>
              </span>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-sm font-semibold tracking-tight text-ink">{node.name}</span>
                  <span class="rounded bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider text-emerald-500 border border-emerald-500/20">
                    {node.status}
                  </span>
                </div>
                <p class="text-xs text-mute mt-0.5">{node.role}</p>
              </div>
            </div>
            <div class="hidden sm:block text-right font-mono text-xs text-dim">
              <span class="block">{node.ip}</span>
              <span class="text-mute">Load: {node.load}</span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- RECRUITER-FRIENDLY 6-SERVICE MICROSERVICE TOPOLOGY GRID (GSAP SCROLL VISUALIZER) -->
    <div
      data-infra-flow-section
      class="mt-12 overflow-hidden rounded-3xl border border-line bg-surface/90 p-6 md:p-10 shadow-2xl backdrop-blur-xl"
      data-reveal="up"
      data-reveal-delay="0.2"
    >
      <!-- Infographic Header -->
      <div class="flex flex-col justify-between gap-4 border-b border-line pb-6 md:flex-row md:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1 text-xs font-semibold text-accent">
            <CheckCircle2 class="size-3.5 text-accent" />
            MICROSERVICE ARCHITEKTUR // 6 EINZELNE SERVICES
          </span>
          <h3 class="mt-3 text-2xl font-semibold tracking-tight text-ink md:text-3xl">
            Spezialisierte Container-Dienste im Überblick
          </h3>
          <p class="mt-1 text-sm text-mute">
            Jede Aufgabe läuft in einem eigenständigen, isolierten Docker-Container.
          </p>
        </div>

        <div class="flex items-center gap-3 font-mono text-xs text-dim bg-elevated px-4 py-2.5 rounded-full border border-line shrink-0">
          <span class="size-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Gesamtdauer:</span>
          <span data-infra-latency-text class="font-bold text-emerald-500 text-sm">0ms</span>
        </div>
      </div>

      <!-- 6 Service Cards Grid (3 Columns on Desktop, 2 on Tablet, 1 on Mobile) -->
      <div class="relative mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          serviceNodes.map((service, index) => {
            const Icon = service.icon;
            return (
              <div
                data-infra-node={index}
                class="group relative flex flex-col justify-between rounded-2xl border border-line bg-elevated/60 p-6 transition-all duration-300 hover:border-accent/40"
              >
                <div>
                  <div class="flex items-center justify-between">
                    <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[10px] font-bold ${service.badgeColor}`}>
                      SERVICE {service.step}
                    </span>
                    <span data-infra-node-dot={index} class="size-3 rounded-full bg-line transition-all duration-300"></span>
                  </div>

                  <div class="mt-5 flex size-12 items-center justify-center rounded-2xl bg-surface border border-line text-ink shadow-sm transition-transform duration-300 group-hover:scale-110">
                    <Icon class="size-6 text-accent" />
                  </div>

                  <h4 class="mt-4 font-semibold tracking-tight text-ink text-lg">
                    {service.name}
                  </h4>
                  <p class="mt-1 text-xs font-medium text-accent">
                    {service.role}
                  </p>
                  <p class="mt-3 text-xs leading-relaxed text-mute">
                    {service.desc}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between font-mono text-[11px] text-dim">
                  <span>{service.tech}</span>
                  <span class="font-bold text-emerald-500">{service.time}</span>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Scroll Progress Status Line -->
      <div class="mt-8 rounded-2xl border border-line bg-elevated p-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between text-xs font-mono text-dim gap-2 mb-2.5">
          <span data-infra-step-label class="text-ink font-medium">1. Symfony Web-App wird angesteuert...</span>
          <span data-infra-packet-inspector class="text-accent font-semibold">Service 1 von 6 aktiv</span>
        </div>
        <div class="relative h-2.5 w-full overflow-hidden rounded-full bg-line">
          <div data-infra-laser-bar class="h-full w-0 rounded-full bg-gradient-to-r from-amber-500 via-sky-500 via-violet-500 via-purple-500 via-indigo-500 to-emerald-500 shadow-md"></div>
        </div>
      </div>
    </div>

    <!-- Grid of 6 Architecture Pillars -->
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.infra.features.map((feature, i) => {
          const Icon = featureIcons[i % featureIcons.length];
          return (
            <div
              class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-line bg-surface p-7 transition-all duration-500 hover:-translate-y-1 hover:border-accent/40 hover:shadow-xl hover:shadow-accent/5"
              data-reveal="up"
              data-reveal-delay={0.06 * i}
            >
              <div class="relative z-10">
                <div class="mb-5 flex size-12 items-center justify-center rounded-2xl border border-line bg-elevated text-accent transition-colors duration-300 group-hover:border-accent/40 group-hover:bg-accent group-hover:text-white">
                  <Icon class="size-6" stroke-width={1.75} />
                </div>
                <h3 class="text-xl font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
                  {feature.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-mute">
                  {feature.description}
                </p>
              </div>
              <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-xs text-dim font-mono">
                <span>0{i + 1} // ARCHITECTURE</span>
                <span class="group-hover:text-accent transition-colors">Active</span>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Technical Docker Stack Terminal (Optionaler Entwickler-Einblick) -->
    <div class="mt-14 overflow-hidden rounded-3xl border border-line bg-[#0d0d12] shadow-2xl shadow-black/40" data-reveal="up" data-reveal-delay="0.2">
      <!-- Terminal Header -->
      <div class="flex items-center justify-between border-b border-white/10 bg-[#16161e] px-5 py-3.5">
        <div class="flex items-center gap-2">
          <span class="size-3 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="size-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="size-3 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="ml-3 font-mono text-xs text-zinc-400 flex items-center gap-2">
            <Terminal class="size-3.5 text-accent" />
            Entwickler-Einblick: Realer Docker Container-Stack
          </span>
        </div>
        <div class="flex items-center gap-3 text-xs font-mono text-zinc-500">
          <span class="hidden sm:inline">Symfony 7.1 • PHP 8.3 FPM</span>
          <span class="flex items-center gap-1.5 text-emerald-400">
            <Check class="size-3.5" />
            6 Services Healthy
          </span>
        </div>
      </div>

      <!-- Terminal Body / Snippet Output -->
      <div class="p-6 font-mono text-xs leading-relaxed text-zinc-300 overflow-x-auto space-y-4">
        <div>
          <div class="flex items-center gap-2 text-zinc-400">
            <span class="text-emerald-400 font-bold">julius@docker3</span>:<span class="text-accent">~</span>$ <span class="text-zinc-100 font-semibold">docker compose ps</span>
          </div>
          <div class="mt-2 pl-4 text-zinc-400 space-y-1">
            <p class="text-zinc-500 font-bold">NAME                        IMAGE                   STATUS                  PORTS</p>
            <p><span class="text-amber-400 font-semibold">symfony-web-app</span>             php:8.3-fpm-alpine      Up 18 days (healthy)    0.0.0.0:4180->80/tcp</p>
            <p><span class="text-sky-400 font-semibold">auth-server-oauth2</span>          keycloak/keycloak:24    Up 30 days (healthy)    0.0.0.0:8080->8080/tcp</p>
            <p><span class="text-violet-400 font-semibold">redis-cache-broker</span>        redis:7-alpine          Up 30 days (healthy)    0.0.0.0:6379->6379/tcp</p>
            <p><span class="text-purple-400 font-semibold">symfony-messenger-worker</span>    php:8.3-fpm-alpine      Up 18 days (healthy)    messenger:consume async</p>
            <p><span class="text-indigo-400 font-semibold">postgres-database</span>         postgres:16-alpine      Up 30 days (healthy)    0.0.0.0:5432->5432/tcp</p>
            <p><span class="text-emerald-400 font-semibold">minio-s3-storage</span>          minio/minio:RELEASE     Up 30 days (healthy)    0.0.0.0:9000->9000/tcp</p>
          </div>
        </div>

        <div class="pt-3 border-t border-white/5">
          <div class="flex items-center gap-2 text-zinc-400">
            <span class="text-emerald-400 font-bold">julius@dev</span>:<span class="text-accent">~/symfony-app</span>$ <span class="text-amber-400 font-semibold">git push origin prod</span>
          </div>
          <div class="mt-2 pl-4 text-zinc-400 space-y-1">
            <p class="text-emerald-400">[✓] GitHub Actions CI triggered (#204)</p>
            <p class="text-emerald-400">[✓] phpstan analyse (level 9) & phpunit: 0 errors</p>
            <p class="text-emerald-400">[✓] Docker multi-stage image built & pushed to ghcr.io/dfgsteam/symfony-app:latest</p>
            <p class="text-sky-400">[✓] Zero-Downtime Migration: php bin/console doctrine:migrations:migrate --no-interaction</p>
            <p class="text-emerald-400">[✓] Watchtower rollout completed across all 6 services 🚀</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
