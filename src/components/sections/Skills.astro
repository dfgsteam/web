---
import {
  CodeXml,
  Database,
  Braces,
  FileCode,
  Table,
  ShoppingCart,
  SquareTerminal,
  Coffee,
  Blocks,
  Cpu,
  Sigma,
  Binary,
  Palette,
} from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { skills } from '../../data/skills';
import type { SkillLevel } from '../../data/skills';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;

const levelOrder: SkillLevel[] = ['master', 'expert', 'advanced', 'medium', 'beginner'];

const barColor: Record<SkillLevel, string> = {
  master: 'bg-gradient-to-r from-accent via-violet-500 to-accent-2 shadow-sm shadow-accent/40',
  expert: 'bg-gradient-to-r from-accent to-violet-500',
  advanced: 'bg-accent/80',
  medium: 'bg-accent/60',
  beginner: 'bg-accent/40',
};

const skillIcons: Record<string, any> = {
  Python: CodeXml,
  SQL: Database,
  PHP: Braces,
  HTML: FileCode,
  'MS Office': Table,
  WooCommerce: ShoppingCart,
  'Linux / BASH': SquareTerminal,
  Java: Coffee,
  TYPO3: Blocks,
  'C++': Cpu,
  Haskell: Sigma,
  Assembly: Binary,
  Photoshop: Palette,
};
---

<section id="skills" class="section-spacing relative isolate overflow-hidden border-t border-line">
  <!-- Ambient Glow Orbs -->
  <div class="glow glow--sky glow--float -left-32 top-20 h-[420px] w-[420px]" aria-hidden="true"></div>
  <div class="glow glow--violet glow--float-slow -right-32 bottom-0 h-[380px] w-[380px]" aria-hidden="true"></div>

  <div class="container-page relative">
    <!-- Section Header -->
    <div class="mb-16 max-w-3xl">
      <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
        {t.skills.label}
      </p>
      <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        {t.skills.heading}
      </h2>
      <p class="mt-5 max-w-xl text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
        {t.skills.subheading}
      </p>
    </div>

    <!-- Skills Grid with 3D Tilt & Staggered Reveal -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {
        skills.map((skill, i) => {
          const Icon = skillIcons[skill.name] ?? CodeXml;
          return (
            <div
              data-tilt
              data-reveal="up"
              data-reveal-delay={(i % 3) * 0.07}
              class="group relative overflow-hidden rounded-2xl border border-line bg-surface/90 p-6 backdrop-blur-md transition-all duration-300 hover:border-accent/60 hover:shadow-xl hover:shadow-accent/5 hover:-translate-y-1"
            >
              <!-- Ambient Subtle Backlight -->
              <div class="absolute -right-12 -top-12 -z-10 size-32 rounded-full bg-accent/10 blur-2xl group-hover:scale-150 transition-transform duration-500"></div>

              <div class="flex items-center justify-between gap-3">
                <h3 class="flex items-center gap-3 font-medium tracking-tight text-ink">
                  <div class="flex size-9 items-center justify-center rounded-xl bg-accent/10 text-accent group-hover:scale-110 group-hover:rotate-6 group-hover:bg-accent/20 transition-all duration-300">
                    <Icon class="size-5 shrink-0" stroke-width={1.75} />
                  </div>
                  <span class="group-hover:text-accent transition-colors font-semibold">{skill.name}</span>
                </h3>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-accent" data-skill-percentage data-target={skill.value}>
                    0%
                  </span>
                  <span class="rounded-full border border-line bg-elevated px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-mute">
                    {t.skills.levels[skill.level]}
                  </span>
                </div>
              </div>

              <!-- Animated Skill Progress Bar -->
              <div class="mt-5 h-2 overflow-hidden rounded-full bg-elevated/70 p-0.5 border border-line/40">
                <div
                  class={`h-full rounded-full ${barColor[skill.level]} origin-left transition-transform duration-700 ease-out`}
                  data-skill-bar
                  data-level={skill.value}
                  style={{ transform: 'scaleX(0)' }}
                ></div>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Skill Levels Legend -->
    <div class="mt-12 flex flex-wrap gap-4 rounded-2xl border border-line/60 bg-surface/50 px-6 py-4 backdrop-blur-md" data-reveal="up" data-reveal-delay="0.2">
      <span class="text-xs uppercase tracking-widest text-dim font-mono self-center mr-2">Proficiency Legend:</span>
      {
        levelOrder.map((level) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-line bg-base/80 px-3 py-1 text-xs font-medium text-mute transition-colors hover:border-accent/40 hover:text-ink">
            <span class={`size-2 rounded-full ${barColor[level]}`} aria-hidden="true"></span>
            {t.skills.levels[level]}
          </span>
        ))
      }
    </div>
  </div>
</section>
