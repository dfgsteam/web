---
import { Sparkles, ShieldCheck, Layers, Bot, Zap, Code2, Database } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;
---

<section id="ai-engineering" class="relative isolate border-t border-line bg-surface/30 md:min-h-[160vh]">
  <!-- Ambient Glow Orbs -->
  <div class="glow glow--sky glow--float -left-32 top-10 h-[420px] w-[420px]" aria-hidden="true"></div>
  <div class="glow glow--violet glow--float-slow -right-32 bottom-0 h-[380px] w-[380px]" aria-hidden="true"></div>

  <!-- Sticky Content Container -->
  <div class="container-page relative section-spacing md:sticky md:top-20 md:py-16">
    <!-- Header -->
    <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-mono text-accent mb-3" data-reveal="up">
          <Sparkles class="size-3.5 text-accent animate-pulse" />
          <span>2026 Developer Workflow</span>
        </div>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          Künstliche Intelligenz & KI-Engineering.
        </h2>
        <p class="mt-4 text-base text-mute leading-relaxed" data-reveal="up" data-reveal-delay="0.1">
          KI ersetzt keinen durchdachten Code, sondern vervielfacht die Entwicklungsgeschwindigkeit – von Prompt Engineering bis zur Einbindung lokaler LLMs.
        </p>
      </div>

      <!-- Scroll Phase Indicator Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/90 px-4 py-2 text-xs font-mono text-dim backdrop-blur-md shrink-0 shadow-md" data-reveal="up" data-reveal-delay="0.15">
        <Bot class="size-4 text-accent" />
        <span id="ai-step-indicator" class="text-ink font-semibold">Phase 1: Prompting & Copilot</span>
      </div>
    </div>

    <!-- 3 Bento Cards Grid with Sequential Scroll Highlight -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="ai-cards-grid">

      <!-- CARD 1: Prompt Engineering & Copilots -->
      <div
        id="ai-card-0"
        class="ai-step-card group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-accent bg-gradient-to-br from-surface via-surface to-accent/10 p-7 shadow-2xl transition-all duration-500 scale-[1.02]"
        data-reveal="up"
      >
        <div class="absolute -right-10 -top-10 size-40 rounded-full bg-accent/20 blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex size-12 items-center justify-center rounded-2xl border border-accent/40 bg-accent/10 text-accent group-hover:scale-110 transition-transform">
              <Code2 class="size-6" stroke-width={1.75} />
            </div>
            <span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-[10px] font-mono text-accent">Phase 1</span>
          </div>

          <h3 class="text-xl font-bold tracking-tight text-ink">
            Prompt-Driven Development
          </h3>
          <p class="mt-2 text-xs text-mute leading-relaxed">
            Nutzung von KI-Assistenten für blitzschnelle Architektur-Prototypen, automatisierte Unit-Tests und sauberes Code-Refactoring.
          </p>

          <ul class="mt-5 space-y-2 text-xs text-mute">
            <li class="flex items-center gap-2">
              <Zap class="size-3.5 text-accent shrink-0" />
              <span>Beschleunigtes Prototyping & Scaffolding</span>
            </li>
            <li class="flex items-center gap-2">
              <Zap class="size-3.5 text-accent shrink-0" />
              <span>Automatisierte Testfall-Erstellung (PyTest)</span>
            </li>
            <li class="flex items-center gap-2">
              <Zap class="size-3.5 text-accent shrink-0" />
              <span>Präzises Code-Review & Linting</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-[11px] font-mono text-dim">
          <span>Produktivität</span>
          <span class="text-accent">High Efficiency</span>
        </div>
      </div>

      <!-- CARD 2: LLM API Integration & RAG -->
      <div
        id="ai-card-1"
        class="ai-step-card group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-line bg-surface p-7 shadow-lg transition-all duration-500 opacity-80"
        data-reveal="up"
        data-reveal-delay="0.1"
      >
        <div class="absolute -left-10 -bottom-10 size-40 rounded-full bg-cyan-500/10 blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex size-12 items-center justify-center rounded-2xl border border-line bg-base text-cyan-400 group-hover:scale-110 transition-transform">
              <Layers class="size-6" stroke-width={1.75} />
            </div>
            <span class="rounded-full border border-line bg-elevated px-2.5 py-0.5 text-[10px] font-mono text-dim">Phase 2</span>
          </div>

          <h3 class="text-xl font-bold tracking-tight text-ink">
            LLM APIs & Custom Workflows
          </h3>
          <p class="mt-2 text-xs text-mute leading-relaxed">
            Integration strukturierter KI-Schnittstellen in bestehende Webanwendungen, E-Commerce Shops und Firmen-Workflows.
          </p>

          <ul class="mt-5 space-y-2 text-xs text-mute">
            <li class="flex items-center gap-2">
              <Database class="size-3.5 text-cyan-400 shrink-0" />
              <span>OpenAI API & Claude Function Calling</span>
            </li>
            <li class="flex items-center gap-2">
              <Database class="size-3.5 text-cyan-400 shrink-0" />
              <span>Strukturierter JSON-Output & Schema-Validierung</span>
            </li>
            <li class="flex items-center gap-2">
              <Database class="size-3.5 text-cyan-400 shrink-0" />
              <span>Automatisierte Text- & Datenextraktion</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-[11px] font-mono text-dim">
          <span>Schnittstellen</span>
          <span class="text-cyan-400">API Integration</span>
        </div>
      </div>

      <!-- CARD 3: DSGVO & Local Models (Ollama) -->
      <div
        id="ai-card-2"
        class="ai-step-card group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-line bg-surface p-7 shadow-lg transition-all duration-500 opacity-80"
        data-reveal="up"
        data-reveal-delay="0.2"
      >
        <div class="absolute -right-10 -bottom-10 size-40 rounded-full bg-emerald-500/10 blur-2xl group-hover:scale-150 transition-transform duration-700 pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="flex size-12 items-center justify-center rounded-2xl border border-line bg-base text-emerald-400 group-hover:scale-110 transition-transform">
              <ShieldCheck class="size-6" stroke-width={1.75} />
            </div>
            <span class="rounded-full border border-line bg-elevated px-2.5 py-0.5 text-[10px] font-mono text-dim">Phase 3</span>
          </div>

          <h3 class="text-xl font-bold tracking-tight text-ink">
            Lokale KI & DSGVO-Konformität
          </h3>
          <p class="mt-2 text-xs text-mute leading-relaxed">
            Einsatz von Open-Source LLMs auf eigener Server-Infrastruktur für 100% Datensouveränität ohne Drittanbieter-Risiken.
          </p>

          <ul class="mt-5 space-y-2 text-xs text-mute">
            <li class="flex items-center gap-2">
              <ShieldCheck class="size-3.5 text-emerald-400 shrink-0" />
              <span>Ollama & Lokales Model-Hosting</span>
            </li>
            <li class="flex items-center gap-2">
              <ShieldCheck class="size-3.5 text-emerald-400 shrink-0" />
              <span>Vollständige DSGVO- & Datenschutzkonformität</span>
            </li>
            <li class="flex items-center gap-2">
              <ShieldCheck class="size-3.5 text-emerald-400 shrink-0" />
              <span>Isolierte Ausführung auf eigenen Hetzner-Servern</span>
            </li>
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-line/60 flex items-center justify-between text-[11px] font-mono text-dim">
          <span>Datenschutz</span>
          <span class="text-emerald-400">Datensouverän</span>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initAiScrollPinning() {
    const section = document.querySelector<HTMLElement>('#ai-engineering');
    const cards = [
      document.querySelector<HTMLElement>('#ai-card-0'),
      document.querySelector<HTMLElement>('#ai-card-1'),
      document.querySelector<HTMLElement>('#ai-card-2'),
    ];
    const indicator = document.querySelector<HTMLElement>('#ai-step-indicator');

    if (!section || !cards[0] || !cards[1] || !cards[2]) return;

    const stepTitles = [
      'Phase 1: Prompting & Copilot',
      'Phase 2: LLM APIs & Integration',
      'Phase 3: Lokale KI & Datenschutz',
    ];

    function updateAiScrollPhase() {
      if (!section) return;

      // Only run sticky highlight logic on desktop screens (md+)
      if (window.innerWidth < 768) {
        cards.forEach((card) => {
          if (!card) return;
          card.style.opacity = '1';
          card.style.transform = 'none';
        });
        return;
      }

      const rect = section.getBoundingClientRect();
      const totalScrollableHeight = rect.height - window.innerHeight;

      if (totalScrollableHeight <= 0) return;

      // Progress from 0 to 1
      const progress = Math.max(0, Math.min(1, -rect.top / totalScrollableHeight));

      let activeIndex = 0;
      if (progress > 0.66) {
        activeIndex = 2;
      } else if (progress > 0.33) {
        activeIndex = 1;
      } else {
        activeIndex = 0;
      }

      if (indicator) {
        indicator.textContent = stepTitles[activeIndex];
      }

      cards.forEach((card, idx) => {
        if (!card) return;

        if (idx === activeIndex) {
          card.classList.remove('border-line', 'bg-surface', 'opacity-80');
          card.classList.add(
            'border-accent',
            'bg-gradient-to-br',
            'from-surface',
            'via-surface',
            'to-accent/10',
            'shadow-2xl',
            'scale-[1.02]',
            'opacity-100'
          );
        } else {
          card.classList.remove(
            'border-accent',
            'bg-gradient-to-br',
            'from-surface',
            'via-surface',
            'to-accent/10',
            'shadow-2xl',
            'scale-[1.02]',
            'opacity-100'
          );
          card.classList.add('border-line', 'bg-surface', 'opacity-70');
        }
      });
    }

    window.addEventListener('scroll', updateAiScrollPhase, { passive: true });
    updateAiScrollPhase();
  }

  initAiScrollPinning();
  document.addEventListener('astro:page-load', initAiScrollPinning);
</script>
