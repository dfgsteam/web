---
import { Mail, Phone, MapPin, Send, CheckCircle2, UserPlus, Copy, Check } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t, lang } = Astro.props;
const email = 'info@julius-hunold.de';
---

<section id="kontakt" class="section-spacing relative isolate overflow-hidden border-t border-line">
  <div class="glow glow--emerald glow--float -left-32 top-16 h-[400px] w-[400px]" aria-hidden="true"></div>
  <div class="glow glow--violet glow--float-slow -right-32 bottom-0 h-[440px] w-[440px]" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div>
        <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
          {t.contact.label}
        </p>
        <h2 class="text-balance text-5xl font-semibold tracking-tight md:text-7xl" data-reveal="up">
          {t.contact.heading}
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-mute" data-reveal="up" data-reveal-delay="0.1">
          {t.contact.subheading}
        </p>

        <!-- Direct Contact Actions (Email + Quick Copy + Recruiter vCard) -->
        <div class="mt-10 space-y-4" data-reveal="up" data-reveal-delay="0.2">
          <!-- Primary Email Card -->
          <div class="group flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface p-5 transition-all duration-300 hover:border-accent/60 hover:bg-accent/5">
            <a href={`mailto:${email}`} class="flex items-center gap-4 flex-1">
              <div class="flex size-10 items-center justify-center rounded-xl bg-accent/10 text-accent group-hover:scale-110 transition-transform">
                <Mail class="size-5" stroke-width={1.75} />
              </div>
              <div>
                <span class="block text-xs uppercase tracking-wider text-dim">{t.contact.emailCta}</span>
                <span class="block font-medium text-ink group-hover:text-accent transition-colors">{email}</span>
              </div>
            </a>

            <!-- Quick Copy Button for Email -->
            <button
              type="button"
              id="copy-email-btn"
              data-email={email}
              data-copied-text={t.contactRecruiter.copied}
              class="relative flex items-center gap-1.5 rounded-xl border border-line bg-base px-3.5 py-2 text-xs font-medium text-mute transition-all duration-300 hover:border-accent hover:text-ink active:scale-95 shrink-0"
              aria-label={t.contactRecruiter.copyEmailBtn}
            >
              <Copy id="copy-email-icon" class="size-3.5 text-accent" />
              <Check id="check-email-icon" class="hidden size-3.5 text-emerald-400" />
              <span id="copy-email-label">{t.contactRecruiter.copyEmailBtn}</span>
            </button>
          </div>

          <!-- Recruiter & HR vCard Card -->
          <a
            href="/julius-hunold.vcf"
            download
            class="group flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface p-5 transition-all duration-300 hover:border-accent/60 hover:bg-accent/5"
          >
            <div class="flex items-center gap-4">
              <div class="flex size-10 items-center justify-center rounded-xl bg-accent/10 text-accent group-hover:scale-110 transition-transform">
                <UserPlus class="size-5" stroke-width={1.75} />
              </div>
              <div>
                <span class="block text-xs uppercase tracking-wider text-dim">{t.contactRecruiter.vcardLabel}</span>
                <span class="block font-medium text-ink group-hover:text-accent transition-colors">{t.contactRecruiter.vcardBtn}</span>
              </div>
            </div>
            <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-medium text-accent">.vcf Download</span>
          </a>

          <!-- Location Card -->
          <div class="flex items-center gap-4 rounded-2xl border border-line bg-surface p-5">
            <div class="flex size-10 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <MapPin class="size-5" stroke-width={1.75} />
            </div>
            <div>
              <span class="block text-xs uppercase tracking-wider text-dim">{t.contact.location}</span>
              <span class="block font-medium text-ink">Sarstedt, Germany</span>
            </div>
          </div>

          <!-- Availability Badge -->
          <div class="flex items-center gap-3 rounded-2xl border border-emerald-500/25 bg-emerald-500/5 px-6 py-4">
            <span class="size-2 animate-pulse rounded-full bg-emerald-500" aria-hidden="true"></span>
            <span class="text-sm font-medium text-emerald-700 dark:text-emerald-300">{t.contact.availability}</span>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="contact-form"
        class="rounded-3xl border border-line bg-surface p-8 md:p-10"
        data-reveal="up"
        data-reveal-delay="0.15"
        data-sent={t.contact.form.sent}
      >
        <div class="space-y-6">
          <div>
            <label for="cf-name" class="mb-2 block text-xs uppercase tracking-wider text-dim">
              {t.contact.form.name}
            </label>
            <input
              id="cf-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              class="w-full rounded-xl border border-line bg-base px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-dim focus:border-accent"
            />
          </div>
          <div>
            <label for="cf-email" class="mb-2 block text-xs uppercase tracking-wider text-dim">
              {t.contact.form.email}
            </label>
            <input
              id="cf-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              class="w-full rounded-xl border border-line bg-base px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-dim focus:border-accent"
            />
          </div>
          <div>
            <label for="cf-message" class="mb-2 block text-xs uppercase tracking-wider text-dim">
              {t.contact.form.message}
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              required
              class="w-full resize-none rounded-xl border border-line bg-base px-4 py-3 text-sm text-ink outline-none transition-colors placeholder:text-dim focus:border-accent"
            ></textarea>
          </div>

          <button
            type="submit"
            class="group inline-flex w-full items-center justify-center gap-2 rounded-full bg-ink px-6 py-4 text-sm font-medium text-white transition-all duration-300 hover:bg-[#2b2b38] hover:shadow-[0_10px_40px_rgba(139,92,246,0.35)] dark:bg-ink dark:text-base dark:hover:bg-[#dedeeb]"
          >
            <Send class="size-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-0.5" />
            {t.contact.form.submit}
          </button>

          <p id="cf-status" class="hidden items-center gap-2 text-sm text-emerald-400" role="status">
            <CheckCircle2 class="size-4" />
            <span></span>
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Form submission handling
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status') as HTMLElement | null;
  const statusText = status?.querySelector('span');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '');
    const email = String(data.get('email') ?? '');
    const message = String(data.get('message') ?? '');
    const subject = encodeURIComponent(`Kontakt von ${name} (${email})`);
    const body = encodeURIComponent(`${message}\n\n— ${name}\n${email}`);
    window.location.href = `mailto:info@julius-hunold.de?subject=${subject}&body=${body}`;
    if (status && statusText) {
      statusText.textContent = form.dataset.sent ?? 'Danke!';
      status.classList.remove('hidden');
      status.classList.add('flex');
    }
  });

  // 1-Click Copy Email Button
  const copyBtn = document.getElementById('copy-email-btn');
  const copyIcon = document.getElementById('copy-email-icon');
  const checkIcon = document.getElementById('check-email-icon');
  const copyLabel = document.getElementById('copy-email-label');

  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.dataset.email || 'info@julius-hunold.de';
    const copiedMsg = copyBtn.dataset.copiedText || 'Kopiert! ✓';

    navigator.clipboard.writeText(email).then(() => {
      if (copyIcon && checkIcon && copyLabel) {
        copyIcon.classList.add('hidden');
        checkIcon.classList.remove('hidden');
        const originalText = copyLabel.textContent;
        copyLabel.textContent = copiedMsg;
        copyBtn.classList.add('border-emerald-500/50', 'text-emerald-400');

        setTimeout(() => {
          copyIcon.classList.remove('hidden');
          checkIcon.classList.add('hidden');
          copyLabel.textContent = originalText;
          copyBtn.classList.remove('border-emerald-500/50', 'text-emerald-400');
        }, 2500);
      }
    });
  });
</script>
