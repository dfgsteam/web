---
import { ArrowRight } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
  posts: {
    slug: string;
    title: string;
    date: Date;
    excerpt: string;
    tags: string[];
  }[];
}

const { t, lang, posts } = Astro.props;

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(d);

const blogHref = (slug: string) => `${lang === 'de' ? '/blog' : '/en/blog'}/${slug}`;
const blogIndexHref = lang === 'de' ? '/blog' : '/en/blog';
---

<section id="blog" class="section-spacing relative isolate overflow-hidden border-t border-line">
  <div class="glow glow--sky glow--float -right-32 top-16 h-[400px] w-[400px]" aria-hidden="true"></div>
  <div class="glow glow--pink glow--float-slow -left-32 bottom-0 h-[360px] w-[360px]" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="mb-14 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
          {t.blog.label}
        </p>
        <h2 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
          {t.blog.heading}
        </h2>
        <p class="mt-5 max-w-xl text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
          {t.blog.subheading}
        </p>
      </div>
      <a
        href={blogIndexHref}
        class="inline-flex items-center gap-2 text-sm font-medium text-accent transition-colors hover:text-ink"
        data-reveal="up"
        data-reveal-delay="0.15"
      >
        {t.blog.readMore}
        <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={2} />
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, i) => (
          <a
            href={blogHref(post.slug)}
            class="group flex flex-col rounded-3xl border border-line bg-surface p-7 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_20px_60px_-20px_rgba(139,92,246,0.3)]"
            data-reveal="up"
            data-reveal-delay={i * 0.06}
          >
            <time datetime={post.date.toISOString()} class="text-xs text-dim">
              {formatDate(post.date)}
            </time>
            <h3 class="mt-3 text-lg font-semibold leading-snug tracking-tight text-ink transition-colors group-hover:text-accent">
              {post.title}
            </h3>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-mute">{post.excerpt}</p>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium text-accent">
              {t.blog.readMore}
              <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={2} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
