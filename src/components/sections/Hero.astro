---
import { ExternalLink, ChevronDown } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import { skills } from '../../data/skills';
import Button from '../ui/Button.astro';

interface Props {
  t: Dict;
  lang: Locale;
}

const { t } = Astro.props;
const stats = t.hero.stats.map((stat, i) => (i === 2 ? { ...stat, value: skills.length } : stat));
---

<section id="top" class="relative isolate flex min-h-[100svh] items-center overflow-hidden pb-24 pt-32">
  <div class="hero-mesh absolute inset-0" aria-hidden="true"></div>
  <div class="grid-backdrop absolute inset-0" data-parallax="30" aria-hidden="true"></div>
  <div
    class="absolute -top-40 left-1/2 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-accent/25 blur-[120px]"
    data-parallax="50"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -right-40 top-1/3 h-[420px] w-[420px] rounded-full bg-accent-2/25 blur-[110px]"
    data-parallax="80"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -left-40 bottom-0 h-[380px] w-[380px] rounded-full bg-amber-400/25 blur-[110px]"
    data-parallax="60"
    aria-hidden="true"
  ></div>

  <div class="container-page relative z-10">
    <div class="max-w-4xl">
      <div
        class="mb-6 flex flex-wrap items-center gap-3"
        data-reveal="up"
        data-reveal-delay="0.1"
      >
        {
          t.hero.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-4 py-1.5 text-xs font-medium tracking-wide text-mute backdrop-blur-md transition-colors duration-300 hover:border-accent hover:text-ink"
            >
              {link.label}
              <ExternalLink class="size-3" stroke-width={2} />
            </a>
          ))
        }
      </div>

      <h1 class="text-balance text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl lg:text-[5.5rem]">
        <span class="block overflow-hidden pb-1">
          <span data-hero-line class="block will-change-transform">{t.hero.titleA}</span>
        </span>
        <span class="block overflow-hidden pb-2">
          <span data-hero-line class="block will-change-transform text-gradient">
            {t.hero.titleB}
          </span>
        </span>
      </h1>

      <p
        class="mt-8 max-w-xl text-lg leading-relaxed text-mute"
        data-reveal="up"
        data-reveal-delay="0.5"
      >
        {t.hero.subtitle}
      </p>

      <div
        class="mt-10 flex flex-wrap items-center gap-4"
        data-reveal="up"
        data-reveal-delay="0.65"
      >
        <Button href="#projekte" variant="primary" size="lg" icon="arrow">
          {t.hero.primaryCta}
        </Button>
        <Button href="#kontakt" variant="outline" size="lg" icon="mail">
          {t.hero.secondaryCta}
        </Button>
      </div>
    </div>

    <dl
      class="mt-20 grid max-w-2xl grid-cols-1 gap-6 border-t border-line pt-8 sm:grid-cols-3"
      data-reveal="up"
      data-reveal-delay="0.8"
    >
      {
        stats.map((stat) => (
          <div>
            <dt class="order-2 mt-1 block text-sm text-mute">{stat.label}</dt>
            <dd class="order-1 text-4xl font-semibold tracking-tight text-ink">
              <span data-count data-count-value={stat.value} data-count-suffix="+">0</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <a
    href="#about"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-[11px] uppercase tracking-widest text-dim transition-colors hover:text-ink"
    aria-label={t.hero.scrollHint}
    data-reveal="up"
    data-reveal-delay="1.1"
  >
    <span>{t.hero.scrollHint}</span>
    <ChevronDown class="size-4 animate-bounce" stroke-width={2} />
  </a>
</section>
