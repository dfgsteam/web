---
import type { Dict, Locale } from '../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
  posts: {
    id: string;
    slug: string;
    title: string;
    date: Date;
    excerpt: string;
    tags: string[];
  }[];
}

const { t, lang, posts } = Astro.props;

const formatDate = (d: Date, locale: string) =>
  new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(d);

const blogHref = (slug: string) => `${lang === 'de' ? '/blog' : '/en/blog'}/${slug}`;
---

<section class="section-spacing pt-40">
    <div class="container-page max-w-4xl">
      <p class="mb-4 text-xs uppercase tracking-widest text-dim" data-reveal="up">
        {t.blog.label}
      </p>
      <h1 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
        {t.blog.heading}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-mute" data-reveal="up" data-reveal-delay="0.1">
        {t.blog.subheading}
      </p>

      <div class="mt-14 space-y-6">
        {
          posts.map((post, i) => (
            <a
              href={blogHref(post.slug)}
              class="group block rounded-3xl border border-line bg-surface p-8 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_20px_60px_-20px_rgba(139,92,246,0.3)]"
              data-reveal="up"
              data-reveal-delay={i * 0.06}
            >
              <div class="flex flex-wrap items-center gap-3 text-xs">
                <time datetime={post.date.toISOString()} class="text-dim">
                  {formatDate(post.date, lang)}
                </time>
                {
                  post.tags.map((tag) => (
                    <span class="rounded-full border border-line bg-elevated px-2.5 py-0.5 text-[11px] text-mute">
                      {tag}
                    </span>
                  ))
                }
              </div>
              <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink transition-colors group-hover:text-accent">
                {post.title}
              </h2>
              <p class="mt-3 text-mute">{post.excerpt}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                {t.blog.readMore}
                <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
