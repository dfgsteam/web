---
import type { CollectionEntry } from 'astro:content';
import type { Dict, Locale } from '../lib/i18n';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import PortfolioBanner from './sections/PortfolioBanner.astro';
import Marquee from './Marquee.astro';
import ProjectsShowcase from './sections/ProjectsShowcase.astro';
import ServicesSection from './sections/ServicesSection.astro';
import BrandBanners from './sections/BrandBanners.astro';
import Skills from './sections/Skills.astro';
import InfraSection from './sections/InfraSection.astro';
import CvSection from './sections/CvSection.astro';
import BlogSection from './sections/BlogSection.astro';
import Contact from './sections/Contact.astro';
import SocialMarquee from './sections/SocialMarquee.astro';
import PrintableCv from './PrintableCv.astro';

interface Props {
  t: Dict;
  lang: Locale;
  projects: CollectionEntry<'projects'>[];
  blogPosts: {
    slug: string;
    title: string;
    date: Date;
    excerpt: string;
    tags: string[];
  }[];
}

const { t, lang, projects, blogPosts } = Astro.props;

const marqueeItems = ['PHP', 'Python', 'SQL', 'JavaScript', 'Tailwind', 'WooCommerce', 'Linux', 'TYPO3', 'Java', 'C++', 'Laravel', 'MySQL'];
---

<Hero t={t} lang={lang} />
<About t={t} lang={lang} />
<PortfolioBanner t={t} lang={lang} />
<Marquee items={marqueeItems} />
<ProjectsShowcase t={t} lang={lang} projects={projects} />
<ServicesSection t={t} lang={lang} />
<BrandBanners t={t} lang={lang} />
<Skills t={t} lang={lang} />
<InfraSection t={t} lang={lang} />
<CvSection t={t} lang={lang} />
<BlogSection t={t} lang={lang} posts={blogPosts} />
<SocialMarquee t={t} lang={lang} />
<Contact t={t} lang={lang} />
<PrintableCv t={t} lang={lang} />
