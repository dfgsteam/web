---
interface Props {
  accentFrom: string;
  accentTo: string;
  url?: string;
  title?: string;
}

const { accentFrom, accentTo, url = 'julius-hunold.de', title = '' } = Astro.props;
const gradient = `linear-gradient(135deg, ${accentFrom} 0%, ${accentTo} 100%)`;
---

<div class="overflow-hidden rounded-xl border border-line bg-white shadow-lg shadow-black/5">
  <div class="flex items-center gap-1.5 border-b border-line bg-elevated px-3 py-2">
    <span class="size-2 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
    <span class="size-2 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
    <span class="size-2 rounded-full bg-[#28c840]" aria-hidden="true"></span>
    <span class="ml-2 flex-1 truncate rounded-md bg-white px-2 py-0.5 text-[10px] text-dim">
      {url}
    </span>
  </div>
  <div class="relative aspect-[16/10] overflow-hidden">
    <div class="absolute inset-0" style={{ background: gradient }}>
      <div
        class="absolute inset-0 opacity-40"
        style={{
          backgroundImage:
            'radial-gradient(circle at 20% 20%, rgba(255,255,255,0.45) 0, transparent 40%), radial-gradient(circle at 80% 80%, rgba(0,0,0,0.25) 0, transparent 45%)',
        }}
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-x-5 bottom-4 top-7 rounded-lg bg-black/20 backdrop-blur-sm"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-x-8 top-11 h-2 w-1/2 rounded-full bg-white/70" aria-hidden="true"></div>
      <div class="absolute inset-x-8 top-16 h-1.5 w-1/3 rounded-full bg-white/35" aria-hidden="true"></div>
      <div class="absolute inset-x-8 bottom-8 h-2.5 w-2/3 rounded-full bg-white/30" aria-hidden="true"></div>
      <span class="absolute bottom-3 right-4 font-mono text-[9px] uppercase tracking-widest text-white/80">
        {title}
      </span>
    </div>
  </div>
</div>
