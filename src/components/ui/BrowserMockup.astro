---
interface Props {
  accentFrom: string;
  accentTo: string;
  url?: string;
  title?: string;
}

const { accentFrom, accentTo, url = 'julius-hunold.de', title = '' } = Astro.props;
const gradient = `linear-gradient(135deg, ${accentFrom} 0%, ${accentTo} 100%)`;
---

<div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl shadow-black/40">
  <div class="flex items-center gap-2 border-b border-line bg-elevated px-4 py-3">
    <span class="size-2.5 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-[#28c840]" aria-hidden="true"></span>
    <span class="ml-3 flex-1 truncate rounded-md bg-surface px-3 py-1 text-[11px] text-dim">
      {url}
    </span>
  </div>
  <div class="relative aspect-[4/3] overflow-hidden">
    <div class="absolute inset-0" style={{ background: gradient }}>
      <div
        class="absolute inset-0 opacity-30"
        style={{
          backgroundImage:
            'radial-gradient(circle at 20% 20%, rgba(255,255,255,0.35) 0, transparent 40%), radial-gradient(circle at 80% 80%, rgba(0,0,0,0.3) 0, transparent 45%)',
        }}
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-x-6 bottom-6 top-10 rounded-xl bg-black/25 backdrop-blur-sm"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-x-10 top-16 h-2.5 w-1/2 rounded-full bg-white/60" aria-hidden="true"></div>
      <div class="absolute inset-x-10 top-24 h-2 w-1/3 rounded-full bg-white/30" aria-hidden="true"></div>
      <div class="absolute inset-x-10 bottom-12 h-3 w-2/3 rounded-full bg-white/25" aria-hidden="true"></div>
      <span class="absolute bottom-4 right-5 font-mono text-[10px] uppercase tracking-widest text-white/70">
        {title}
      </span>
    </div>
  </div>
</div>
