---
import type { CollectionEntry } from 'astro:content';
import { ArrowRight } from '@lucide/astro';
import type { Dict, Locale } from '../../lib/i18n';
import BrowserMockup from './BrowserMockup.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  t: Dict;
  lang: Locale;
  index: number;
}

const { project, t, lang, index } = Astro.props;
const { title, tagline, summary, tech, status, accentFrom, accentTo } = project.data;
const slug = project.id.split('/').slice(1).join('/');
const href = `${lang === 'de' ? '/projekte' : '/en/projekte'}/${slug}`;
---

<a
  href={href}
  data-tilt
  class="group relative flex h-full flex-col gap-5 rounded-3xl border border-line bg-surface p-6 transition-colors duration-300 will-change-transform hover:border-accent/50 hover:shadow-[0_20px_60px_-20px_rgba(139,92,246,0.35)]"
  aria-label={title}
>
  <div class="mx-auto w-full max-w-sm overflow-hidden rounded-xl">
    <div class="transition-transform duration-500 group-hover:scale-[1.03]">
      <BrowserMockup accentFrom={accentFrom} accentTo={accentTo} title={tagline} />
    </div>
  </div>

  <div class="flex items-center justify-between gap-3">
    <h3 class="text-xl font-semibold tracking-tight text-ink">{title}</h3>
    <StatusBadge status={status} t={t} />
  </div>

  <p class="-mt-3 text-sm text-mute">{summary}</p>

  <ul class="flex flex-wrap gap-2">
    {
      tech.slice(0, 5).map((item) => (
        <li class="rounded-full border border-line bg-elevated px-3 py-1 text-[11px] text-mute">
          {item}
        </li>
      ))
    }
  </ul>

  <span class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-medium text-accent">
    {t.projects.viewDetails}
    <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" stroke-width={2} />
  </span>
  <span class="sr-only">{index + 1}</span>
</a>
