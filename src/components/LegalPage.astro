---
import type { Dict, Locale } from '../lib/i18n';
import type { LegalDoc } from '../data/legal';

interface Props {
  t: Dict;
  lang: Locale;
  doc: LegalDoc;
}

const { t, lang, doc } = Astro.props;
const homeHref = lang === 'de' ? '/' : '/en';

function splitBlocks(body: string): string[] {
  return body.split(/\n{2,}/).filter(Boolean);
}

function isListBlock(block: string): boolean {
  return block.split('\n').some((line) => line.trim().startsWith('- '));
}
---

<article class="section-spacing pt-40">
  <div class="container-page max-w-3xl">
    <a
      href={homeHref}
      class="mb-10 inline-flex items-center gap-2 text-sm text-mute transition-colors hover:text-ink"
      data-reveal="up"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
      {lang === 'de' ? 'Zur Startseite' : 'Back to home'}
    </a>

    <h1 class="text-balance text-4xl font-semibold tracking-tight md:text-6xl" data-reveal="up">
      {doc.title}
    </h1>
    <p class="mt-3 text-sm text-dim" data-reveal="up" data-reveal-delay="0.05">{doc.updated}</p>

    <div class="mt-12 space-y-12">
      {
        doc.sections.map((section) => (
          <section data-reveal="up">
            <h2 class="mb-4 text-xl font-semibold tracking-tight text-ink">{section.heading}</h2>
            {
              splitBlocks(section.body).map((block) => {
                const lines = block.split('\n');
                if (lines.every((l) => l.trim().startsWith('### '))) {
                  return (
                    <h3 class="mt-6 mb-3 text-base font-semibold tracking-tight text-ink">
                      {lines[0].trim().replace(/^###\s*/, '')}
                    </h3>
                  );
                }
                if (lines.some((l) => l.trim().startsWith('### '))) {
                  const headingLines = lines.filter((l) => l.trim().startsWith('### '));
                  const rest = lines.filter((l) => !l.trim().startsWith('### '));
                  return (
                    <>
                      {headingLines.map((l) => (
                        <h3 class="mt-6 mb-3 text-base font-semibold tracking-tight text-ink">
                          {l.trim().replace(/^###\s*/, '')}
                        </h3>
                      ))}
                      {rest.map((l) => (
                        <p class="my-2 leading-relaxed text-mute">{l}</p>
                      ))}
                    </>
                  );
                }
                if (isListBlock(block)) {
                  const items = block
                    .split('\n')
                    .filter((l) => l.trim().startsWith('- '))
                    .map((l) => l.trim().replace(/^-\s*/, ''));
                  return (
                    <ul class="mt-3 space-y-2">
                      {items.map((item) => (
                        <li class="relative pl-6 leading-relaxed text-mute">
                          <span class="absolute left-0 top-[0.6em] size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  );
                }
                return <p class="my-2 leading-relaxed text-mute">{block}</p>;
              })
            }
          </section>
        ))
      }
    </div>
  </div>
</article>
