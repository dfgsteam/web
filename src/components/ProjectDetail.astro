---
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import type { Dict, Locale } from '../lib/i18n';
import { render } from 'astro:content';
import BrowserMockup from './ui/BrowserMockup.astro';
import StatusBadge from './ui/StatusBadge.astro';
import TextReveal from './animations/TextReveal.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  t: Dict;
  lang: Locale;
  related: CollectionEntry<'projects'>[];
}

const { project, t, lang, related } = Astro.props;
const { Content } = await render(project);
const homeHref = lang === 'de' ? '/' : '/en';
const { title, tagline, client, category, status, year, tech, summary, accentFrom, accentTo, liveUrl } = project.data;

const relatedHref = (p: CollectionEntry<'projects'>) => {
  const slug = p.id.split('/').slice(1).join('/');
  return `${lang === 'de' ? '/projekte' : '/en/projekte'}/${slug}`;
};
---

<article class="section-spacing pt-40">
  <div class="container-page">
    <a
      href={homeHref}
      class="mb-10 inline-flex items-center gap-2 text-sm text-mute transition-colors hover:text-ink"
      data-reveal="up"
    >
      <ArrowLeft class="size-4" />
      {t.projects.back}
    </a>

    <div class="mb-4 flex flex-wrap items-center gap-3" data-reveal="up" data-reveal-delay="0.05">
      <StatusBadge status={status} t={t} />
      <span class="text-xs uppercase tracking-wider text-dim">
        {t.projects.category[category]} · {year}
      </span>
    </div>

    <TextReveal
      text={title}
      className="text-balance text-5xl font-semibold leading-[1.05] tracking-tight md:text-7xl"
    />

    <p class="mt-5 max-w-2xl text-xl text-mute" data-reveal="up" data-reveal-delay="0.2">
      {tagline}
    </p>

    <div class="mx-auto mt-12 w-full max-w-4xl" data-reveal="up" data-reveal-delay="0.25">
      <BrowserMockup accentFrom={accentFrom} accentTo={accentTo} title={tagline} />
    </div>

    <div class="mt-16 grid gap-16 lg:grid-cols-[1.6fr_1fr]">
      <div class="prose-detail">
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-widest text-ink" data-reveal="up">
          {t.projects.overview}
        </h2>
        <Content />
      </div>

      <aside class="lg:sticky lg:top-32 lg:self-start" data-reveal="up" data-reveal-delay="0.1">
        <div class="rounded-3xl border border-line bg-surface p-8">
          <h3 class="mb-6 text-sm font-semibold uppercase tracking-widest text-ink">
            {t.projects.overview}
          </h3>
          <dl class="space-y-5">
            <div>
              <dt class="text-xs uppercase tracking-wider text-dim">{t.projects.clientLabel?.[category] ?? t.projects.client}</dt>
              <dd class="mt-1 font-medium text-ink">{client}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-dim">{t.projects.year}</dt>
              <dd class="mt-1 font-medium text-ink">{year}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-dim">{t.projects.tech}</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {
                  tech.map((item) => (
                    <span class="rounded-full border border-line bg-elevated px-3 py-1 text-[11px] text-mute">
                      {item}
                    </span>
                  ))
                }
              </dd>
            </div>
          </dl>
          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-base transition-colors hover:bg-white"
            >
              <ExternalLink class="size-4" />
              Live
            </a>
          )}
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <section class="mt-28 border-t border-line pt-16">
        <h2 class="mb-10 text-2xl font-semibold tracking-tight" data-reveal="up">
          {t.projects.related}
        </h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            related.map((p, i) => (
              <a
                href={relatedHref(p)}
                class="group rounded-2xl border border-line bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50"
                data-reveal="up"
                data-reveal-delay={i * 0.05}
              >
                <div class="mb-4 flex items-center justify-between gap-3">
                  <h3 class="font-medium tracking-tight text-ink">{p.data.title}</h3>
                  <StatusBadge status={p.data.status} t={t} />
                </div>
                <p class="text-sm text-mute">{p.data.summary}</p>
              </a>
            ))
          }
        </div>
      </section>
    )}
  </div>
</article>
