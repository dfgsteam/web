---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Dict, Locale } from '../lib/i18n';

interface Props {
  t: Dict;
  lang: Locale;
  title?: string;
  description?: string;
  path?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  jsonLd?: Record<string, unknown>[];
}

const { t, lang, ogType, ogImage, publishedTime, jsonLd = [] } = Astro.props;
const pageTitle = Astro.props.title ?? t.meta.title;
const pageDescription = Astro.props.description ?? t.meta.description;
const pagePath = Astro.props.path ?? Astro.url.pathname;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f6fa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0c" />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.classList.add('js');
        } catch (e) {
          /* ignore */
        }
      })();
    </script>
    <Seo
      title={pageTitle}
      description={pageDescription}
      keywords={t.meta.keywords}
      lang={lang}
      path={pagePath}
      ogType={ogType}
      ogImage={ogImage}
      publishedTime={publishedTime}
      jsonLd={jsonLd}
    />
    <ClientRouter />
    <!-- Matomo -->
    <script is:inline>
      var _paq = (window._paq = window._paq || []);
      _paq.push(['disableCookies']);
      _paq.push(['enableLinkTracking']);
      (function () {
        var u = 'https://tracking.hunold24.de/';
        _paq.push(['setTrackerUrl', u + 'matomo.php']);
        _paq.push(['setSiteId', '3']);
        var d = document,
          g = d.createElement('script'),
          s = d.getElementsByTagName('script')[0];
        g.async = true;
        g.src = u + 'matomo.js';
        s.parentNode.insertBefore(g, s);
      })();

      var previousUrl = '';
      document.addEventListener('astro:page-load', function () {
        if (window._paq) {
          if (previousUrl) {
            window._paq.push(['setReferrerUrl', previousUrl]);
          }
          window._paq.push(['setCustomUrl', window.location.href]);
          window._paq.push(['setDocumentTitle', document.title]);
          window._paq.push(['trackPageView']);
          previousUrl = window.location.href;
        }
      });
    </script>
    <noscript>
      <img referrerpolicy="no-referrer-when-downgrade" src="https://tracking.hunold24.de/matomo.php?idsite=3&amp;rec=1" style="border:0" alt="" />
    </noscript>
    <!-- End Matomo -->
  </head>
  <body class="noise">
    <div id="scroll-progress" class="fixed inset-x-0 top-0 z-[60] h-[3px] origin-left scale-x-0 bg-gradient-to-r from-accent via-accent-2 to-amber-400" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
    <Nav t={t} lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} lang={lang} />
    <script>
      import '../scripts/global.ts';
    </script>
  </body>
</html>
